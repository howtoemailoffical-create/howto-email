---
import '../styles/global.css';
const { title='howto.email — Email infrastructure, explained', description='A free, vendor-neutral technical reference for learning, building, securing and troubleshooting email infrastructure.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#070b12"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><title>{title}</title></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><nav class="wrap nav" aria-label="Main navigation"><a class="brand" href="/" aria-label="howto.email home"><span class="brand-mark">✉</span> howto.<strong>email</strong></a><div class="nav-links"><a href="/learn/">Learn</a><a href="/reference/">Reference</a><a href="/do/">Do</a><a href="/tools/">Tools</a><a href="/start/">Start</a><a href="/topics/">Topics</a></div><a class="nav-search" href="/search/" aria-label="Search documentation"><span>⌕</span> Search <kbd>⌘K</kbd></a><a class="github-link" href="https://github.com/howtoemailoffical-create/howto-email" rel="noopener">GitHub ↗</a></nav></header><main id="main"><slot /></main><footer class="site-footer"><div class="wrap footer-row"><div><a class="brand footer-brand" href="/">howto.<strong>email</strong></a><p>Free, vendor-neutral email documentation.</p></div><nav aria-label="Footer navigation"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/accessibility/">Accessibility</a><a href="/disclaimer/">Disclaimer</a></nav></div></footer><script is:inline>document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();location.href='/search/';}else if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)){e.preventDefault();location.href='/search/';}});</script></body></html>
