---
import '../styles/global.css';
const { title='howto.email — Email infrastructure, explained', description='A free, vendor-neutral technical reference for learning, building, securing and troubleshooting email infrastructure.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#070b12"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><title>{title}</title></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><nav class="wrap nav" aria-label="Main navigation"><a class="brand" href="/" aria-label="howto.email home"><span class="brand-mark">✉</span> howto.<strong>email</strong></a><button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-links" aria-label="Open navigation menu"><span aria-hidden="true">☰</span><span class="mobile-menu-label">Menu</span></button><div class="nav-links" id="mobile-nav-links"><a href="/learn/">Learn</a><a href="/reference/">Reference</a><a href="/do/">Do</a><a href="/tools/">Tools</a><a href="/start/">Start</a><a href="/topics/">Topics</a></div><a class="nav-search" href="/search/" aria-label="Search documentation"><span>⌕</span> Search <kbd>⌘K</kbd></a><a class="github-link" href="https://github.com/howtoemailoffical-create/howto-email" rel="noopener">GitHub ↗</a></nav></header><style is:global>
.mobile-menu-toggle{display:none}
@media(max-width:1050px){
.site-header .nav{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;min-height:64px;padding:10px 0;align-items:center}
.site-header .brand{width:auto;min-width:0;margin:0;white-space:nowrap;grid-column:1;grid-row:1}
.site-header .nav-search{grid-column:2;grid-row:1;order:initial;min-height:44px;padding:9px 12px;white-space:nowrap}
.site-header .nav-search kbd{display:none}
.site-header .mobile-menu-toggle{display:inline-flex;grid-column:3;grid-row:1;align-items:center;justify-content:center;gap:7px;min-height:44px;min-width:44px;padding:8px 12px;border:1px solid #3b5d80;border-radius:9px;background:#102033;color:#eef6ff;font:600 .9rem inherit;cursor:pointer}
.site-header .nav-links{display:none;grid-column:1/-1;grid-row:2;flex-direction:column;gap:0;width:100%;padding:8px 0;border-top:1px solid #26384f}
.site-header .nav-links.is-open{display:flex}
.site-header .nav-links a{display:block;padding:12px 14px;min-height:44px;border-radius:7px}
.site-header .nav-links a:hover,.site-header .nav-links a:focus-visible{background:#14263a}
.site-header .github-link{display:none;grid-column:1/-1;grid-row:3;order:initial;width:100%;padding:12px 14px;min-height:44px}
.site-header .github-link.is-open{display:block}
}
@media(max-width:390px){.site-header .brand{font-size:1rem}.site-header .brand-mark{width:25px;height:25px;margin-right:3px}.site-header .nav-search{font-size:0;gap:0}.site-header .nav-search span{font-size:1.4rem}.site-header .mobile-menu-toggle{padding:8px}.site-header .mobile-menu-label{display:none}}
</style><main id="main"><slot /></main><footer class="site-footer"><div class="wrap footer-row"><div><a class="brand footer-brand" href="/">howto.<strong>email</strong></a><p>Free, vendor-neutral email documentation.</p></div><nav aria-label="Footer navigation"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/accessibility/">Accessibility</a><a href="/disclaimer/">Disclaimer</a></nav></div></footer><script is:inline>
document.querySelectorAll('a[href]').forEach(a=>{a.target='_blank';a.rel=(a.rel+' noopener noreferrer').trim();});
const menuButton=document.querySelector('.mobile-menu-toggle'),menuLinks=document.querySelector('#mobile-nav-links'),githubLink=document.querySelector('.github-link');function setMenu(open){menuButton.setAttribute('aria-expanded',String(open));menuButton.setAttribute('aria-label',open?'Close navigation menu':'Open navigation menu');menuButton.querySelector('[aria-hidden]').textContent=open?'✕':'☰';menuLinks.classList.toggle('is-open',open);githubLink.classList.toggle('is-open',open)}menuButton.addEventListener('click',()=>setMenu(menuButton.getAttribute('aria-expanded')!=='true'));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menuButton.getAttribute('aria-expanded')==='true'){setMenu(false);menuButton.focus()}});window.matchMedia('(min-width:1051px)').addEventListener('change',e=>{if(e.matches)setMenu(false)});document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();location.href='/search/';}else if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement?.tagName)){e.preventDefault();location.href='/search/';}});</script></body></html>
