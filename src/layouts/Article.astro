---
import Base from './Base.astro';
const { title, description, section, tags=[] } = Astro.props;
---
<Base title={title + ' | howto.email'} description={description}>
  <div id="article-progress" class="article-progress" role="progressbar" aria-label="Article reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="article-progress-fill"></span></div>
  <div class="wrap article-shell">
    <aside class="article-meta">
      <a class="back-link" href={'/'+section.toLowerCase()+'/'}>← {section}</a>
      <p class="kicker">TOPICS</p>
      <div class="tag-list">{tags.map((tag:string)=><span class="eyebrow">{tag}</span>)}</div>
      <nav class="article-contents" aria-label="On this page" id="article-contents" hidden>
        <details open><summary>On this page</summary><ol id="article-contents-list"></ol></details>
      </nav>
    </aside>
    <article class="article" id="reading-article">
      <header>
        <p class="kicker">{section.toUpperCase()}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="article-controls"><button type="button" id="article-print">Print / Save PDF</button></div>
      </header>
      <div class="article-body" id="article-body"><slot /></div>
    </article>
  </div>
</Base>
<style is:global>
.article-progress{position:fixed;top:0;left:0;right:0;height:4px;z-index:999;pointer-events:none;background:transparent}
.article-progress span{display:block;width:0;height:100%;background:#60a5fa;transition:width .12s linear}
.article-controls{margin:1rem 0}.article-controls button{border:1px solid #52627a;border-radius:8px;background:transparent;color:inherit;padding:.65rem .95rem;cursor:pointer;min-height:44px}
.article-contents{margin-top:1.5rem;min-width:0}.article-contents details{border:1px solid var(--border,#37485f);border-radius:8px;padding:.6rem}.article-contents summary{font-weight:700}.article-contents ol{margin:.6rem 0 0;padding-left:1.4rem;max-height:45vh;overflow-y:auto}.article-contents li{margin:.45rem 0;line-height:1.45;overflow-wrap:anywhere}.article-contents a{font-size:.88rem}.article-contents .article-toc-sub{margin-left:.8rem;list-style:circle}
@media(max-width:820px){.article-contents ol{max-height:280px}}
@media print{
  @page{size:auto;margin:17mm 16mm}
  html,body{background:#fff!important;color:#111!important;font:11pt/1.5 Georgia,"Times New Roman",serif!important}
  body{margin:0!important;padding:0!important;overflow:visible!important}
  #article-progress,.article-controls,.article-meta,.site-header,.site-footer,.skip,header.site-header,footer,.nav,.footer,.site-nav{display:none!important}
  main,.wrap,.article-shell,.article,.article-body{display:block!important;position:static!important;float:none!important;width:100%!important;max-width:none!important;min-width:0!important;height:auto!important;max-height:none!important;margin:0!important;padding:0!important;overflow:visible!important;box-shadow:none!important;border:0!important;background:transparent!important;color:#111!important}
  .article header{margin:0 0 12pt!important;padding:0!important;border:0!important;background:transparent!important}
  .article header .kicker{display:none!important}
  .article h1{font:700 20pt/1.2 Georgia,"Times New Roman",serif!important;margin:0 0 8pt!important}
  .article .lead{font:11pt/1.5 Georgia,"Times New Roman",serif!important;margin:0 0 12pt!important;color:#222!important}
  .article-body :is(h2,h3,h4){font-family:Georgia,"Times New Roman",serif!important;font-weight:700!important;color:#111!important;margin:14pt 0 5pt!important;padding:0!important;border:0!important;break-after:avoid-page;page-break-after:avoid}
  .article-body h2{font-size:15pt!important}.article-body h3{font-size:12.5pt!important}.article-body h4{font-size:11pt!important}
  .article-body :is(p,li,dd,dt,blockquote){color:#111!important;font-size:11pt!important;line-height:1.5!important;orphans:3;widows:3}
  .article-body p{margin:0 0 8pt!important}
  .article-body :is(ul,ol){padding-left:20pt!important;margin:4pt 0 10pt!important}
  .article-body li{margin:0 0 3pt!important;break-inside:avoid-page}
  .article-body :is(h2,h3,h4)+:is(p,ul,ol){break-before:avoid-page;page-break-before:avoid}
  .article-body a{color:#111!important;text-decoration:underline!important;overflow-wrap:anywhere}
  .article-body :is(pre,code){color:#111!important;background:transparent!important;border:0!important;box-shadow:none!important}
  .article-body pre{font:9pt/1.4 ui-monospace,SFMono-Regular,Consolas,monospace!important;white-space:pre-wrap!important;overflow-wrap:anywhere!important;word-break:break-word!important;padding:5pt 0!important;margin:8pt 0!important;max-width:100%!important;overflow:visible!important}
  .article-body :is(img,svg){max-width:100%!important;height:auto!important;break-inside:avoid-page}
  .article-body table{display:table!important;width:100%!important;max-width:100%!important;border-collapse:collapse!important;table-layout:fixed!important;font-size:9pt!important;break-inside:auto!important}
  .article-body :is(th,td){border:1px solid #777!important;background:transparent!important;color:#111!important;padding:4pt!important;vertical-align:top!important;overflow-wrap:anywhere!important;word-break:break-word!important}
  .article-body tr{break-inside:avoid-page;page-break-inside:avoid}
  .article-body thead{display:table-header-group}
  .article-body tfoot{display:table-footer-group}
  .article-body :is(figure,blockquote){margin:8pt 0!important;padding:0!important;border:0!important;break-inside:auto!important}
  .article-body :is(.card,.callout,.notice,.note){background:transparent!important;color:#111!important;box-shadow:none!important;border:0!important;padding:0!important}
}

</style>
<script>
const body=document.querySelector('#article-body');
const contents=document.querySelector('#article-contents');
const list=document.querySelector('#article-contents-list');
const headings=[...body.querySelectorAll('h2,h3')];
const used=new Set([...document.querySelectorAll('[id]')].map(x=>x.id));
for(const heading of headings){
  if(!heading.id){
    const base=(heading.textContent||'section').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-')||'section';
    let id=base,n=2;while(used.has(id))id=base+'-'+n++;heading.id=id;used.add(id);
  }
  const li=document.createElement('li');if(heading.tagName==='H3')li.className='article-toc-sub';
  const link=document.createElement('a');link.href='#'+encodeURIComponent(heading.id);link.textContent=heading.textContent||'Section';li.append(link);list.append(li);
}
if(headings.length>=2)contents.hidden=false;
document.querySelector('#article-print')?.addEventListener('click',()=>window.print());
const progress=document.querySelector('#article-progress');
const fill=document.querySelector('#article-progress-fill');
const article=document.querySelector('#reading-article');
let scheduled=false;
function updateProgress(){
  scheduled=false;
  const start=article.getBoundingClientRect().top+window.scrollY;
  const end=start+article.offsetHeight-window.innerHeight;
  const percent=end<=start?(window.scrollY>=start?100:0):Math.max(0,Math.min(100,Math.round((window.scrollY-start)/(end-start)*100)));
  fill.style.width=percent+'%';progress.setAttribute('aria-valuenow',String(percent));
}
function scheduleProgress(){if(!scheduled){scheduled=true;requestAnimationFrame(updateProgress)}}
window.addEventListener('scroll',scheduleProgress,{passive:true});
window.addEventListener('resize',scheduleProgress,{passive:true});
updateProgress();
</script>