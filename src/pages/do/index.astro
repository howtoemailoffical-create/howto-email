---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const articles=(await getCollection('articles')).filter(a=>a.data.section==='Do').sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<Base title="Email how-to guides | howto.email" description="Practical procedures for configuring, testing, securing and troubleshooting email infrastructure."><div class="wrap page"><p class="kicker">DO</p><h1>Make the change safely.</h1><p class="lead">Practical procedures for the work: publish records, test authentication, diagnose delivery problems and operate email without guessing.</p><div class="article-list">{articles.map(a=><a class="article-row" href={'/'+a.id+'/'}><div><h2>{a.data.title}</h2><p>{a.data.description}</p></div><span>→</span></a>)}</div></div></Base>