---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const articles=await getCollection('articles');
const count=section=>articles.filter(a=>a.data.section===section).length;
---
<Base title="howto.email — A practical guide to email" description="Learn how email works, look up a protocol, or troubleshoot a delivery problem. Free documentation and tools for email administrators.">
<section class="wrap editorial-home">
  <header class="editorial-intro">
    <p class="editorial-label">A practical guide to email</p>
    <h1>Email is a lot of moving parts.<br />Find the one you need.</h1>
    <p>Mail servers, DNS records, authentication, and delivery problems. This is a collection of explanations, reference notes, and instructions for working with them.</p>
    <a class="reading-link" href="/start/">New to email administration? Start here →</a>
  </header>
  <div class="home-desk">
    <section class="home-main-list" aria-labelledby="working-on"><h2 id="working-on">What are you working on?</h2>
      <a href="/troubleshoot/"><h3>Mail isn't arriving</h3><p>Work through a bounce, a delay, or a message that landed in spam.</p><span aria-hidden="true">→</span></a>
      <a href="/tools/domain-check/"><h3>Check a domain's email setup</h3><p>Look up MX records and check SPF, DKIM, DMARC, and transport security.</p><span aria-hidden="true">→</span></a>
      <a href="/tools/header-analyzer/"><h3>Follow a message's route</h3><p>Read message headers to see the hops, timing, and authentication results.</p><span aria-hidden="true">→</span></a>
      <a href="/do/"><h3>Make a change</h3><p>Step-by-step instructions for configuration, testing, and migrations.</p><span aria-hidden="true">→</span></a>
    </section>
    <aside class="desk-reference"><h2>Keep these handy</h2><p>The references people often need while checking a record or reading a log.</p>
      <ul><li><a href="/reference/smtp-status-codes/">SMTP response codes</a></li><li><a href="/reference/spf/">SPF records and lookups</a></li><li><a href="/reference/dkim/">DKIM signatures and keys</a></li><li><a href="/reference/dmarc/">DMARC policies and alignment</a></li><li><a href="/reference/mx/">MX records</a></li><li><a href="/glossary/">Email glossary</a></li></ul>
      <a href="/reference/">All reference material →</a>
    </aside>
  </div>
  <section class="browse-library"><h2>Browse the documentation</h2><div class="editorial-columns">
    <div><h3><a href="/learn/">Learn</a></h3><p>How the pieces fit together, from sending a message to keeping a mail service running.</p><small>{count('Learn')} explanations</small></div>
    <div><h3><a href="/reference/">Reference</a></h3><p>Record formats, protocol details, headers, and status codes to look up as you work.</p><small>{count('Reference')} references</small></div>
    <div><h3><a href="/do/">How-to guides</a></h3><p>Instructions you can follow, with checks to help you tell whether a change worked.</p><small>{count('Do')} guides</small></div>
  </div><p class="browse-topics">Looking for a particular subject? <a href="/topics/">Browse by topic</a> or <a href="/search/">search the documentation</a>.</p></section>
  <section class="practice-note"><div><h2>Try what you've learned</h2><p>Practice questions explain the answers. The assessment gives you 40 questions and a certificate of completion if you pass.</p></div><a href="/quiz/">Practice and assessment →</a></section>
  <p class="editorial-colophon">Free to read, vendor-neutral, and <a href="https://github.com/howtoemailoffical-create/howto-email">open source</a>. <a href="/about/">About howto.email</a></p>
</section>
</Base>
