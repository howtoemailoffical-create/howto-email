---
import Base from '../../layouts/Base.astro';
---
<Base title="Email tools — howto.email" description="Free utilities for inspecting and troubleshooting email infrastructure.">
  <section class="wrap page">
    <p class="kicker">TOOLS</p>
    <h1>Email tools</h1>
    <p class="lead">Small, practical utilities tied directly to the howto.email documentation. No account required.</p>
    <div class="grid tool-grid">
      <a class="card" href="/tools/domain-check/">
        <span class="card-num">01</span>
        <h2>Domain Check</h2>
        <p>Inspect DMARC, SPF, DKIM, BIMI and MTA-STS, then get relevant howto.email reading for anything worth investigating.</p>
        <small>Check a domain →</small>
      </a>
      <a class="card" href="/tools/api-playground/">
        <span class="card-num">02</span>
        <h2>API Playground</h2>
        <p>Run public DNS lookups through the howto.email API, inspect records, and copy or share results.</p>
        <small>Open playground →</small>
      </a>
      <a class="card" href="/tools/header-analyzer/">
        <span class="card-num">03</span>
        <h2>Email Header Analyzer</h2>
        <p>Inspect authentication results, trace Received hops, and identify possible delivery delays. Headers stay in your browser.</p>
        <small>Analyze headers →</small>
      </a>
    </div>
  </section>
</Base>
