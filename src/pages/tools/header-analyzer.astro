---
import Base from '../../layouts/Base.astro';
---
<Base title="Email Header Analyzer | howto.email" description="Privately inspect email authentication results, DKIM signatures, ARC history, delivery timeline and message identities in your browser.">
<main class="wrap page header-tool">
 <p class="kicker">TOOLS / EMAIL HEADER ANALYZER</p>
 <h1>Email Header Analyzer</h1>
 <p class="lead">Understand an email's authentication reports and delivery path without uploading your message. Parsing stays in your browser.</p>
 <form id="ha-form">
  <label for="ha-input">Raw message headers</label>
  <textarea id="ha-input" rows="11" maxlength="200000" spellcheck="false" required placeholder="Received: from smtp.example.net ...&#10;Authentication-Results: mx.example.org; spf=pass ...&#10;From: Sender &lt;sender@example.net&gt;" aria-describedby="ha-privacy"></textarea>
  <p id="ha-privacy" class="ha-muted">Private by design: no headers are transmitted, saved or logged by this tool. Headers can contain private email addresses, IPs and message IDs.</p>
  <div class="ha-actions"><button type="submit" class="ha-primary">Analyze headers</button><button type="button" id="ha-sample">Load example</button><button type="button" id="ha-clear">Clear</button></div>
 </form>
 <p id="ha-status" role="status" aria-live="polite"></p>
 <div id="ha-results" hidden>
  <div class="ha-toolbar"><div><p class="kicker">LOCAL ANALYSIS</p><h2>Message results</h2></div><div class="ha-actions"><button id="ha-copy" type="button">Copy report</button><button id="ha-print" type="button">Print / Save PDF</button></div></div>
  <section class="ha-section" aria-labelledby="ha-summary-heading">
   <h2 id="ha-summary-heading">Summary</h2>
   <div id="ha-verdict" class="ha-verdict"></div><div id="ha-metrics" class="ha-metrics"></div><div id="ha-observations" class="ha-observations"></div>
  </section>
  <section class="ha-section" aria-labelledby="ha-auth-heading">
   <h2 id="ha-auth-heading">Authentication</h2><p class="ha-muted">SPF, DKIM and DMARC below are results <em>reported by a mail server in these headers</em>. This analyzer does not independently verify them.</p>
   <div id="ha-auth" class="ha-cards"></div>
   <div id="ha-alignment" class="ha-explanation"></div>
   <details id="ha-arc-section" class="ha-expander" hidden><summary>ARC history and evidence</summary><div id="ha-arc" class="ha-cards"></div></details>
   <div id="ha-signatures" class="ha-signatures"></div>
  </section>
  <section class="ha-section" aria-labelledby="ha-route-heading">
   <h2 id="ha-route-heading">Delivery timeline</h2>
   <p class="ha-muted">Received lines appear oldest first below. Hop timing is derived from server-supplied timestamps; clocks may differ and untrusted Received fields can be forged.</p>
   <div id="ha-hops" class="ha-hops"></div>
  </section>
  <section class="ha-section" aria-labelledby="ha-meta-heading">
   <h2 id="ha-meta-heading">Message details</h2>
   <dl id="ha-identity" class="ha-identity"></dl>
   <details class="ha-expander"><summary>All parsed header fields</summary><div id="ha-fields" class="ha-fields"></div></details>
  </section>
  <p class="ha-muted">This tool parses untrusted text. It does not perform DNS lookups, cryptographically validate DKIM/ARC, establish sender identity, or decide whether a message is safe.</p>
 </div>
</main>
</Base>
<style is:global>
.header-tool{max-width:1080px;width:100%;min-width:0}
.header-tool *, .header-tool *:before,.header-tool *:after{box-sizing:border-box;min-width:0}
.header-tool [hidden]{display:none!important}
.header-tool form,.header-tool .ha-section{border:1px solid var(--border,#36465a);border-radius:12px;padding:clamp(1rem,2.4vw,1.5rem);margin:1.25rem 0}
.header-tool label{display:block;font-weight:700;margin-bottom:.6rem}
.header-tool textarea{display:block;width:100%;min-height:200px;resize:vertical;padding:1rem;background:#111b2a;border:1px solid #50627c;border-radius:8px;color:inherit;font:13px/1.55 ui-monospace,Consolas,monospace}
.header-tool button{border:1px solid #52627a;border-radius:8px;padding:.65rem .95rem;background:transparent;color:inherit;font:inherit;cursor:pointer}
.header-tool button.ha-primary{background:#2867b5;border-color:#2867b5;color:#fff}
.header-tool button:focus-visible,.header-tool textarea:focus-visible,.header-tool summary:focus-visible{outline:2px solid #80baff;outline-offset:2px}
.header-tool .ha-muted{color:var(--muted,#aab9cb);font-size:.9rem;line-height:1.65}
.header-tool .ha-actions,.header-tool .ha-toolbar{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap}
.header-tool .ha-toolbar{justify-content:space-between;margin:1.5rem 0}
.header-tool .ha-toolbar h2{margin:0}
.header-tool #ha-status{min-height:1.4rem}.header-tool #ha-status[data-error]{color:#eaa0a0}
.header-tool .ha-section>h2{margin:0 0 1rem;font-size:1.3rem}
.header-tool .ha-verdict{padding:1rem 1.2rem;border-left:4px solid #89a1bf;background:rgba(120,145,170,.09);border-radius:8px;line-height:1.6}
.header-tool .ha-verdict strong{display:block;font-size:1.05rem}
.header-tool .ha-verdict p{margin:.3rem 0 0}
.header-tool .ha-verdict[data-state="attention"]{border-left-color:#e08780}
.header-tool .ha-verdict[data-state="pass"]{border-left-color:#48b98a}
.header-tool .ha-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin:1rem 0}
.header-tool .ha-metric,.header-tool .ha-card,.header-tool .ha-hop{border:1px solid var(--border,#37485f);border-radius:9px;padding:1rem;min-width:0;overflow:hidden}
.header-tool .ha-metric span{display:block;color:var(--muted,#abb9c9);font-size:.79rem}
.header-tool .ha-metric strong{display:block;font-size:1.2rem;line-height:1.45;overflow-wrap:anywhere}
.header-tool .ha-observations{display:grid;gap:.55rem}
.header-tool .ha-observation{padding:.8rem 1rem;border:1px solid #35465c;border-radius:7px;line-height:1.55;overflow-wrap:anywhere}
.header-tool .ha-observation[data-warning]{border-left:3px solid #d79b55}
.header-tool .ha-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:1rem 0}
.header-tool .ha-card-head{display:flex;align-items:center;justify-content:space-between;gap:.6rem;flex-wrap:wrap}
.header-tool .ha-card h3{margin:0;font-size:1rem}
.header-tool .ha-badge{font-weight:700;font-size:.77rem;background:#2d4054;color:#dbe9f4;border-radius:5px;padding:.3rem .55rem;overflow-wrap:anywhere}
.header-tool .ha-card[data-state="pass"] .ha-badge{background:#1c4639;color:#b5f2d4}
.header-tool .ha-card[data-state="fail"] .ha-badge,.header-tool .ha-card[data-state="softfail"] .ha-badge,.header-tool .ha-card[data-state="permerror"] .ha-badge{background:#532b34;color:#ffd2cf}
.header-tool .ha-pairs{display:grid;grid-template-columns:minmax(85px,120px) minmax(0,1fr);gap:.55rem .8rem;margin:.85rem 0 0;font-size:.85rem;line-height:1.5}
.header-tool .ha-pairs dt{color:var(--muted,#a9b8c9)}.header-tool .ha-pairs dd{margin:0;overflow-wrap:anywhere;word-break:break-word}
.header-tool .ha-explanation{padding:.8rem 1rem;border-left:3px solid #6999c6;line-height:1.6;overflow-wrap:anywhere}
.header-tool .ha-expander{margin-top:1rem;border-top:1px solid #35465c;padding-top:1rem}
.header-tool .ha-card details,.header-tool .ha-hop details{border-top:1px solid #35465c;margin-top:.9rem;padding-top:.7rem}
.header-tool summary{cursor:pointer;overflow-wrap:anywhere;font-weight:600}
.header-tool pre{margin:.65rem 0 0;max-width:100%;width:100%;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-all;overflow-x:auto;font:.77rem/1.55 ui-monospace,Consolas,monospace;background:rgba(100,125,155,.13);border-radius:7px;padding:.7rem}
.header-tool .ha-signatures{margin-top:1rem;overflow-wrap:anywhere}
.header-tool .ha-signatures h3{font-size:1rem;margin:.6rem 0}
.header-tool .ha-hops{display:grid;gap:.8rem}
.header-tool .ha-hop{border-left:3px solid #5a8bbd}
.header-tool .ha-hop[data-warning]{border-left-color:#e6a052}
.header-tool .ha-hop h3{margin:0 0 .7rem;font-size:.95rem}
.header-tool .ha-route{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:.65rem;align-items:center}
.header-tool .ha-node{overflow-wrap:anywhere;word-break:break-word;font-size:.86rem;line-height:1.55}
.header-tool .ha-node small{display:block;color:var(--muted,#a9b8c9)}
.header-tool .ha-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:.7rem 0}
.header-tool .ha-tags span{border-radius:5px;background:rgba(108,137,165,.16);padding:.25rem .45rem;font-size:.79rem;overflow-wrap:anywhere}
.header-tool .ha-identity{display:grid;grid-template-columns:minmax(105px,155px) minmax(0,1fr);margin:0}
.header-tool .ha-identity dt,.header-tool .ha-identity dd{border-bottom:1px solid #35465c;padding:.75rem 0;overflow-wrap:anywhere;word-break:break-word}
.header-tool .ha-identity dt{font-size:.8rem;color:var(--muted,#a9b8c9);font-weight:600}
.header-tool .ha-identity dd{margin:0;padding-left:1rem}
.header-tool .ha-field{display:grid;grid-template-columns:minmax(90px,175px) minmax(0,1fr);gap:.7rem;padding:.65rem 0;border-bottom:1px solid #35465c}
.header-tool .ha-field strong{font-size:.8rem;overflow-wrap:anywhere}
.header-tool .ha-field details{overflow-wrap:anywhere;word-break:break-all;font-size:.83rem}
@media(max-width:780px){.header-tool .ha-cards{grid-template-columns:1fr}.header-tool .ha-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.header-tool .ha-metrics{grid-template-columns:1fr 1fr}.header-tool .ha-route,.header-tool .ha-field,.header-tool .ha-identity{grid-template-columns:1fr}.header-tool .ha-identity dt{border-bottom:0;padding-bottom:0}.header-tool .ha-identity dd{padding:.15rem 0 .75rem}}
@media print{body{background:white!important;color:#111!important}.header-tool form,.header-tool #ha-status,.header-tool .ha-toolbar button,.header-tool .ha-fields{display:none!important}.header-tool .ha-section,.header-tool .ha-card,.header-tool .ha-hop,.header-tool .ha-metric{background:white!important;color:#111!important;border-color:#aaa!important;break-inside:avoid-page}.header-tool .ha-metrics{grid-template-columns:repeat(4,minmax(0,1fr))}.header-tool .ha-cards{grid-template-columns:1fr 1fr}.header-tool .ha-badge{background:#eee!important;color:#111!important}.header-tool .ha-muted,.header-tool dt,.header-tool .ha-metric span{color:#555!important}header,nav,footer{display:none!important}}
</style>