---
import Base from '../../layouts/Base.astro';
---
<Base title="Email Header Analyzer | howto.email" description="Privately inspect email authentication results, DKIM signatures, ARC history, delivery timeline and message identities in your browser.">
<main class="wrap page header-tool">
 <p class="kicker">TOOLS / EMAIL HEADER ANALYZER</p>
 <h1>Email Header Analyzer</h1>
 <p class="lead">Understand an email's authentication reports and delivery path without uploading your message. Parsing stays in your browser.</p>
 <form id="ha-form">
  <label for="ha-input">Raw message headers</label>
  <textarea id="ha-input" rows="11" maxlength="200000" spellcheck="false" required placeholder="Received: from smtp.example.net ...&#10;Authentication-Results: mx.example.org; spf=pass ...&#10;From: Sender &lt;sender@example.net&gt;" aria-describedby="ha-privacy"></textarea>
  <p id="ha-privacy" class="ha-muted">Private by design: no headers are transmitted, saved or logged by this tool. Headers can contain private email addresses, IPs and message IDs.</p>
  <div class="ha-actions"><button type="submit" class="ha-primary">Analyze headers</button><button type="button" id="ha-sample">Load example</button><button type="button" id="ha-clear">Clear</button></div>
 </form>
 <p id="ha-status" role="status" aria-live="polite"></p>
 <div id="ha-results" hidden>
  <div class="ha-toolbar"><div><p class="kicker">LOCAL ANALYSIS</p><h2>Message results</h2></div><div class="ha-actions"><button id="ha-copy" type="button">Copy report</button><button id="ha-print" type="button">Print / Save PDF</button></div></div>
  <section class="ha-section" aria-labelledby="ha-summary-heading">
   <h2 id="ha-summary-heading">Summary</h2>
   <div id="ha-verdict" class="ha-verdict"></div><div id="ha-metrics" class="ha-metrics"></div><div id="ha-observations" class="ha-observations"></div>
  </section>
  <section class="ha-section" aria-labelledby="ha-auth-heading">
   <h2 id="ha-auth-heading">Authentication</h2><p class="ha-muted">SPF, DKIM and DMARC below are results <em>reported by a mail server in these headers</em>. This analyzer does not independently verify them.</p>
   <div id="ha-auth" class="ha-cards"></div>
   <div id="ha-alignment" class="ha-explanation"></div>
   <details id="ha-arc-section" class="ha-expander" hidden><summary>ARC history and evidence</summary><div id="ha-arc" class="ha-cards"></div></details>
   <div id="ha-signatures" class="ha-signatures"></div>
  </section>
  <section class="ha-section" aria-labelledby="ha-route-heading">
   <h2 id="ha-route-heading">Delivery timeline</h2>
   <p class="ha-muted">Received lines appear oldest first below. Hop timing is derived from server-supplied timestamps; clocks may differ and untrusted Received fields can be forged.</p>
   <div id="ha-hops" class="ha-hops"></div>
  </section>
  <section class="ha-section" aria-labelledby="ha-meta-heading">
   <h2 id="ha-meta-heading">Message details</h2>
   <dl id="ha-identity" class="ha-identity"></dl>
   <details class="ha-expander"><summary>All parsed header fields</summary><div id="ha-fields" class="ha-fields"></div></details>
  </section>
  <p class="ha-muted">This tool parses untrusted text. It does not perform DNS lookups, cryptographically validate DKIM/ARC, establish sender identity, or decide whether a message is safe.</p>
 </div>
</main>
</Base>
<style is:global>
.header-tool{max-width:1080px;width:100%;min-width:0}
.header-tool *, .header-tool *:before,.header-tool *:after{box-sizing:border-box;min-width:0}
.header-tool [hidden]{display:none!important}
.header-tool form,.header-tool .ha-section{border:1px solid var(--border,#36465a);border-radius:12px;padding:clamp(1rem,2.4vw,1.5rem);margin:1.25rem 0}
.header-tool label{display:block;font-weight:700;margin-bottom:.6rem}
.header-tool textarea{display:block;width:100%;min-height:200px;resize:vertical;padding:1rem;background:#111b2a;border:1px solid #50627c;border-radius:8px;color:inherit;font:13px/1.55 ui-monospace,Consolas,monospace}
.header-tool button{border:1px solid #52627a;border-radius:8px;padding:.65rem .95rem;background:transparent;color:inherit;font:inherit;cursor:pointer}
.header-tool button.ha-primary{background:#2867b5;border-color:#2867b5;color:#fff}
.header-tool button:focus-visible,.header-tool textarea:focus-visible,.header-tool summary:focus-visible{outline:2px solid #80baff;outline-offset:2px}
.header-tool .ha-muted{color:var(--muted,#aab9cb);font-size:.9rem;line-height:1.65}
.header-tool .ha-actions,.header-tool .ha-toolbar{display:flex;gap:.6rem;align-items:center;flex-wrap:wrap}
.header-tool .ha-toolbar{justify-content:space-between;margin:1.5rem 0}
.header-tool .ha-toolbar h2{margin:0}
.header-tool #ha-status{min-height:1.4rem}.header-tool #ha-status[data-error]{color:#eaa0a0}
.header-tool .ha-section>h2{margin:0 0 1rem;font-size:1.3rem}
.header-tool .ha-verdict{padding:1rem 1.2rem;border-left:4px solid #89a1bf;background:rgba(120,145,170,.09);border-radius:8px;line-height:1.6}
.header-tool .ha-verdict strong{display:block;font-size:1.05rem}
.header-tool .ha-verdict p{margin:.3rem 0 0}
.header-tool .ha-verdict[data-state="attention"]{border-left-color:#e08780}
.header-tool .ha-verdict[data-state="pass"]{border-left-color:#48b98a}
.header-tool .ha-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin:1rem 0}
.header-tool .ha-metric,.header-tool .ha-card,.header-tool .ha-hop{border:1px solid var(--border,#37485f);border-radius:9px;padding:1rem;min-width:0;overflow:hidden}
.header-tool .ha-metric span{display:block;color:var(--muted,#abb9c9);font-size:.79rem}
.header-tool .ha-metric strong{display:block;font-size:1.2rem;line-height:1.45;overflow-wrap:anywhere}
.header-tool .ha-observations{display:grid;gap:.55rem}
.header-tool .ha-observation{padding:.8rem 1rem;border:1px solid #35465c;border-radius:7px;line-height:1.55;overflow-wrap:anywhere}
.header-tool .ha-observation[data-warning]{border-left:3px solid #d79b55}
.header-tool .ha-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:1rem 0}
.header-tool .ha-card-head{display:flex;align-items:center;justify-content:space-between;gap:.6rem;flex-wrap:wrap}
.header-tool .ha-card h3{margin:0;font-size:1rem}
.header-tool .ha-badge{font-weight:700;font-size:.77rem;background:#2d4054;color:#dbe9f4;border-radius:5px;padding:.3rem .55rem;overflow-wrap:anywhere}
.header-tool .ha-card[data-state="pass"] .ha-badge{background:#1c4639;color:#b5f2d4}
.header-tool .ha-card[data-state="fail"] .ha-badge,.header-tool .ha-card[data-state="softfail"] .ha-badge,.header-tool .ha-card[data-state="permerror"] .ha-badge{background:#532b34;color:#ffd2cf}
.header-tool .ha-pairs{display:grid;grid-template-columns:minmax(85px,120px) minmax(0,1fr);gap:.55rem .8rem;margin:.85rem 0 0;font-size:.85rem;line-height:1.5}
.header-tool .ha-pairs dt{color:var(--muted,#a9b8c9)}.header-tool .ha-pairs dd{margin:0;overflow-wrap:anywhere;word-break:break-word}
.header-tool .ha-explanation{padding:.8rem 1rem;border-left:3px solid #6999c6;line-height:1.6;overflow-wrap:anywhere}
.header-tool .ha-expander{margin-top:1rem;border-top:1px solid #35465c;padding-top:1rem}
.header-tool .ha-card details,.header-tool .ha-hop details{border-top:1px solid #35465c;margin-top:.9rem;padding-top:.7rem}
.header-tool summary{cursor:pointer;overflow-wrap:anywhere;font-weight:600}
.header-tool pre{margin:.65rem 0 0;max-width:100%;width:100%;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-all;overflow-x:auto;font:.77rem/1.55 ui-monospace,Consolas,monospace;background:rgba(100,125,155,.13);border-radius:7px;padding:.7rem}
.header-tool .ha-signatures{margin-top:1rem;overflow-wrap:anywhere}
.header-tool .ha-signatures h3{font-size:1rem;margin:.6rem 0}
.header-tool .ha-hops{display:grid;gap:.8rem}
.header-tool .ha-hop{border-left:3px solid #5a8bbd}
.header-tool .ha-hop[data-warning]{border-left-color:#e6a052}
.header-tool .ha-hop h3{margin:0 0 .7rem;font-size:.95rem}
.header-tool .ha-route{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:.65rem;align-items:center}
.header-tool .ha-node{overflow-wrap:anywhere;word-break:break-word;font-size:.86rem;line-height:1.55}
.header-tool .ha-node small{display:block;color:var(--muted,#a9b8c9)}
.header-tool .ha-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:.7rem 0}
.header-tool .ha-tags span{border-radius:5px;background:rgba(108,137,165,.16);padding:.25rem .45rem;font-size:.79rem;overflow-wrap:anywhere}
.header-tool .ha-identity{display:grid;grid-template-columns:minmax(105px,155px) minmax(0,1fr);margin:0}
.header-tool .ha-identity dt,.header-tool .ha-identity dd{border-bottom:1px solid #35465c;padding:.75rem 0;overflow-wrap:anywhere;word-break:break-word}
.header-tool .ha-identity dt{font-size:.8rem;color:var(--muted,#a9b8c9);font-weight:600}
.header-tool .ha-identity dd{margin:0;padding-left:1rem}
.header-tool .ha-field{display:grid;grid-template-columns:minmax(90px,175px) minmax(0,1fr);gap:.7rem;padding:.65rem 0;border-bottom:1px solid #35465c}
.header-tool .ha-field strong{font-size:.8rem;overflow-wrap:anywhere}
.header-tool .ha-field details{overflow-wrap:anywhere;word-break:break-all;font-size:.83rem}
.header-tool .ha-evidence{position:relative;min-width:0;margin-top:.6rem}.header-tool .ha-evidence pre{padding-right:5.5rem;overflow-wrap:anywhere;white-space:pre-wrap}.header-tool .ha-evidence-copy{position:absolute;right:.6rem;top:.6rem;width:2.75rem;height:2.75rem;padding:.35rem;border:1px solid var(--border,#52647b);border-radius:6px;background:#223044;color:#fff;font:inherit;font-size:.85rem;font-weight:600;cursor:pointer;z-index:1}.header-tool .ha-evidence-copy:hover{background:#344b66}.header-tool .ha-evidence-copy:focus-visible{outline:3px solid #7db8ff;outline-offset:2px}
@media(max-width:780px){.header-tool .ha-cards{grid-template-columns:1fr}.header-tool .ha-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.header-tool .ha-metrics{grid-template-columns:1fr 1fr}.header-tool .ha-route,.header-tool .ha-field,.header-tool .ha-identity{grid-template-columns:1fr}.header-tool .ha-identity dt{border-bottom:0;padding-bottom:0}.header-tool .ha-identity dd{padding:.15rem 0 .75rem}}
@media print{body{background:white!important;color:#111!important}.header-tool form,.header-tool #ha-status,.header-tool .ha-toolbar button,.header-tool .ha-fields{display:none!important}.header-tool .ha-section,.header-tool .ha-card,.header-tool .ha-hop,.header-tool .ha-metric{background:white!important;color:#111!important;border-color:#aaa!important;break-inside:avoid-page}.header-tool .ha-metrics{grid-template-columns:repeat(4,minmax(0,1fr))}.header-tool .ha-cards{grid-template-columns:1fr 1fr}.header-tool .ha-badge{background:#eee!important;color:#111!important}.header-tool .ha-muted,.header-tool dt,.header-tool .ha-metric span{color:#555!important}header,nav,footer{display:none!important}}
</style>
<script>
import PostalMime from 'postal-mime';
const $=s=>document.querySelector(s);
const input=$('#ha-input'),status=$('#ha-status'),results=$('#ha-results');
const ids=['verdict','metrics','observations','auth','alignment','arc','signatures','hops','identity','fields'];
const areas=Object.fromEntries(ids.map(k=>[k,$('#ha-'+k)]));
let report='',analysisSequence=0;
const SAMPLE=['Received: from relay.example.net (relay.example.net [192.0.2.20])',' by inbox.example.org with ESMTPS; Wed, 07 Oct 2026 15:03:10 +0000','Received: from sender.example.com (sender.example.com [192.0.2.10])',' by relay.example.net with ESMTPS; Wed, 07 Oct 2026 15:03:04 +0000','Authentication-Results: inbox.example.org; spf=pass smtp.mailfrom=example.com;',' dkim=pass header.d=example.com; dmarc=pass header.from=example.com','DKIM-Signature: v=1; a=rsa-sha256; d=example.com; s=mail; bh=EXAMPLE; b=EXAMPLE','From: Example Sender <sender@example.com>','To: Example Recipient <recipient@example.org>','Subject: Synthetic example','Date: Wed, 07 Oct 2026 15:02:55 +0000','Message-ID: <demo@example.com>'].join('\r\n');
function el(parent,tag,text='',klass=''){const e=document.createElement(tag);e.textContent=String(text);if(klass)e.className=klass;parent.append(e);return e}
function field(dl,label,value){el(dl,'dt',label);el(dl,'dd',value||'Not present')}
function all(h,key){return h.filter(x=>x.key===key).map(x=>x.value)}
function one(h,key){return all(h,key)[0]||''}
function parseAuth(h,key){return all(h,key).flatMap(raw=>{const parts=raw.split(';'),server=parts.shift()?.trim()||'Unknown';return parts.map(p=>{const m=p.trim().match(/^([a-z][a-z0-9_-]*)\s*=\s*([a-z0-9_-]+)/i);return m?{method:m[1].toLowerCase(),result:m[2].toLowerCase(),evidence:p.trim(),server}:null}).filter(Boolean)})}
function prop(text,key){return text.match(new RegExp('(?:^|[\\s;])'+key.replace('.','\\.')+'\\s*=\\s*([^\\s;]+)','i'))?.[1]||''}
function dkim(raw){const tags={};raw.split(';').forEach(piece=>{const m=piece.trim().match(/^([a-z]+)\s*=\s*(.*)$/i);if(m)tags[m[1].toLowerCase()]=m[2].trim()});return tags}
function hop(raw){const semicolon=raw.lastIndexOf(';'),stamp=semicolon<0?'':raw.slice(semicolon+1).trim(),ms=stamp?Date.parse(stamp):NaN;return{from:raw.match(/\bfrom\s+(.+?)(?=\s+by\s+|;|$)/i)?.[1]||'Unknown source',by:raw.match(/\bby\s+(.+?)(?=\s+(?:with|id|for|via)\s+|;|$)/i)?.[1]||'Unknown receiver',protocol:raw.match(/\bwith\s+([a-z0-9_-]+)/i)?.[1]||'',stamp,ms:Number.isFinite(ms)?ms:null,raw}}
function duration(s){return s<1?Math.round(s*1000)+' ms':s<60?s.toFixed(1)+' sec':s<3600?(s/60).toFixed(1)+' min':(s/3600).toFixed(2)+' hr'}
function metric(name,value){const c=el(areas.metrics,'div','','ha-metric');el(c,'span',name);el(c,'strong',value)}
function note(value,warning=false){const n=el(areas.observations,'div',value,'ha-observation');if(warning)n.dataset.warning='true'}
function authCard(container,name,entries){const c=el(container,'article','','ha-card'),head=el(c,'div','','ha-card-head');el(head,'h3',name.toUpperCase());const states=[...new Set(entries.map(e=>e.result))];const state=states.join(' / ')||'not reported';if(states.length===1)c.dataset.state=state;el(head,'span',state.toUpperCase(),'ha-badge');if(!entries.length){el(c,'p','No result reported.');return}const dl=el(c,'dl','','ha-pairs');field(dl,'Reported by',entries[0].server);const id=entries[0].evidence.match(/(?:header\.from|header\.d|smtp\.mailfrom|smtp\.helo)=([^\s;]+)/i);if(id)field(dl,'Identity',id[0]);if(entries.length>1)field(dl,'Entries',String(entries.length));const d=el(c,'details');el(d,'summary','View reported evidence');entries.forEach(e=>{const wrap=el(d,'div','','ha-evidence');const pre=el(wrap,'pre',e.server+'; '+e.evidence);const button=el(wrap,'button','⧉','ha-evidence-copy');button.type='button';button.setAttribute('aria-label','Copy '+name.toUpperCase()+' reported evidence');button.addEventListener('click',async()=>{const value=pre.textContent||'';try{if(!navigator.clipboard?.writeText)throw new Error('Clipboard unavailable');await navigator.clipboard.writeText(value)}catch{const t=document.createElement('textarea');t.value=value;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();const ok=document.execCommand('copy');t.remove();if(!ok){button.textContent='Failed';return}}button.textContent='✓';setTimeout(()=>{if(button.isConnected)button.textContent='⧉'},1800)})})}
function address(value){if(Array.isArray(value))return value.map(address).filter(Boolean).join(', ');if(!value)return '';if(value.group)return address(value.group);return value.name?value.name+' <'+(value.address||'')+'>':value.address||''}
function domain(v){v=(v||'').toLowerCase();return (v.match(/@([a-z0-9.-]+)/)?.[1]||v).replace(/\.$/,'')}
function related(a,b){return !!(a&&b&&(a===b||a.endsWith('.'+b)||b.endsWith('.'+a)))}
async function analyze(){
 const run=++analysisSequence;results.hidden=true;report='';
 if(!input.value.trim()){status.textContent='Paste headers first.';status.dataset.error='true';return}
 const normalized=input.value.replace(/\r\n?/g,'\n'),lines=normalized.split('\n');let cut=lines.findIndex(line=>!line.trim());if(cut<0)cut=lines.length;
 let mail;try{mail=await PostalMime.parse(lines.slice(0,cut).join('\r\n')+'\r\n\r\n')}catch{if(run!==analysisSequence)return;results.hidden=true;status.textContent='Could not parse those headers.';status.dataset.error='true';return}
 if(run!==analysisSequence)return;
 const h=mail.headers||[];if(!h.length){results.hidden=true;status.textContent='No recognizable headers found.';status.dataset.error='true';return}
 Object.values(areas).forEach(e=>e.replaceChildren());delete status.dataset.error;results.hidden=false;
 const auth=parseAuth(h,'authentication-results'),history=parseAuth(h,'arc-authentication-results'),signatures=all(h,'dkim-signature').map(dkim),received=all(h,'received').map(hop).reverse();
 const arcInstances=new Set([...all(h,'arc-seal'),...all(h,'arc-message-signature'),...all(h,'arc-authentication-results')].map(v=>v.match(/(?:^|;)\s*i\s*=\s*(\d+)/i)?.[1]).filter(Boolean));
 const dated=received.filter(v=>v.ms!==null),elapsed=dated.length>1?(dated[dated.length-1].ms-dated[0].ms)/1000:null;
 const core=['spf','dkim','dmarc'].map(method=>({method,entries:auth.filter(x=>x.method===method)})),fail=core.filter(x=>x.entries.some(e=>['fail','softfail','temperror','permerror','policy'].includes(e.result))),missing=core.filter(x=>!x.entries.length);
 const allPass=core.every(x=>x.entries.length&&x.entries.every(e=>e.result==='pass'));
 areas.verdict.dataset.state=fail.length?'attention':allPass?'pass':'partial';
 el(areas.verdict,'strong',fail.length?'Review authentication failures':allPass?'All three methods report pass':'Incomplete or mixed authentication reporting');
 el(areas.verdict,'p',fail.length?'At least one method reports a failure or error. Check which trusted server added that claim.':allPass?'Reported SPF, DKIM and DMARC values are pass. These are not independent verification results.':'One or more methods did not report pass. Review the individual cards.');
 metric('Received hops',received.length);metric('Observed transit',elapsed===null?'Unknown':elapsed<0?'Clock mismatch':duration(elapsed));metric('SPF / DKIM / DMARC',core.map(x=>x.entries.map(e=>e.result).join(', ')||'—').join(' / '));metric('ARC instances',arcInstances.size);
 core.forEach(x=>authCard(areas.auth,x.method,x.entries));[...new Set(auth.map(e=>e.method).filter(x=>!['spf','dkim','dmarc'].includes(x)))].forEach(x=>authCard(areas.auth,x,auth.filter(e=>e.method===x)));
 const fromDomain=domain(mail.from?.address||''),spfDomains=auth.filter(e=>e.method==='spf'&&e.result==='pass').map(e=>domain(prop(e.evidence,'smtp.mailfrom'))).filter(Boolean),dkimDomains=auth.filter(e=>e.method==='dkim'&&e.result==='pass').map(e=>domain(prop(e.evidence,'header.d'))).filter(Boolean);
 el(areas.alignment,'strong','Sender identifier comparison');
 el(areas.alignment,'p',fromDomain&&(spfDomains.length||dkimDomains.length)?'From: '+fromDomain+'. Passing SPF MailFrom: '+(spfDomains.join(', ')||'not reported')+'. Passing DKIM domains: '+(dkimDomains.join(', ')||'not reported')+'. '+([...spfDomains,...dkimDomains].some(v=>related(v,fromDomain))?'Some domains appear related.':'No simple domain relationship found.')+' This is informational only, not a validated DMARC alignment verdict.':'Insufficient reported identifier information for a meaningful comparison.');
 $('#ha-arc-section').hidden=!arcInstances.size&&!history.length&&!auth.some(x=>x.method==='arc');
 [...new Set(history.map(x=>x.method))].forEach(x=>authCard(areas.arc,x+' (ARC history)',history.filter(e=>e.method===x)));
 if(arcInstances.size)el(areas.arc,'p',arcInstances.size+' distinct ARC instance number(s) reported. This does not cryptographically validate the chain or establish the number of forwarders.');
 if(signatures.length){el(areas.signatures,'h3','DKIM signatures ('+signatures.length+')');const dl=el(areas.signatures,'dl','','ha-pairs');signatures.forEach((s,i)=>field(dl,'Signature '+(i+1),'d='+(s.d||'?')+' · s='+(s.s||'?')+' · a='+(s.a||'?')));el(areas.signatures,'p','Presence of a signature is not evidence that it passed verification.','ha-muted')}
 let slow=0,skew=0;
 received.forEach((v,i)=>{const c=el(areas.hops,'article','','ha-hop');el(c,'h3','Hop '+(i+1)+(i===0?' · Earliest recorded':''));const route=el(c,'div','','ha-route'),left=el(route,'div','','ha-node');el(left,'small','FROM');el(left,'div',v.from);el(route,'span','→');const right=el(route,'div','','ha-node');el(right,'small','BY');el(right,'div',v.by);const meta=el(c,'div','','ha-tags');if(v.protocol)el(meta,'span',v.protocol.toUpperCase());el(meta,'span',v.ms===null?v.stamp||'Unknown time':new Date(v.ms).toISOString());const prev=received[i-1];if(prev&&prev.ms!==null&&v.ms!==null){const delay=(v.ms-prev.ms)/1000;if(delay<0){skew++;c.dataset.warning='true';el(meta,'span','Clock mismatch')}else{el(meta,'span','+'+duration(delay));if(delay>300){slow++;c.dataset.warning='true'}}}const d=el(c,'details');el(d,'summary','View original Received field');el(d,'pre',v.raw)});
 if(!received.length)el(areas.hops,'p','No Received headers found.');
 if(fail.length)note('Authentication errors: '+fail.map(x=>x.method.toUpperCase()).join(', ')+'. DMARC can fail while SPF/DKIM pass if sender domains do not align.',true);
 if(missing.length)note('Not reported: '+missing.map(x=>x.method.toUpperCase()).join(', ')+'. Missing results do not establish failure.',true);
 if(slow)note(slow+' hop interval(s) exceeded five minutes. Consult server logs to determine whether queueing or filtering occurred.',true);
 if(skew)note(skew+' hop interval(s) have negative timing. Clock skew or untrusted fields could explain this.',true);
 if(!received.length)note('No delivery trace can be constructed.',true);
 if(!fail.length&&!missing.length&&!slow&&!skew)note('No obvious issues were found among the reported headers and timings.');
 note('Authentication-Results and Received headers can be forged. This tool cannot independently establish authenticity.');
 [['From',address(mail.from)||one(h,'from')],['To',address(mail.to)||one(h,'to')],['Reply-To',address(mail.replyTo)||one(h,'reply-to')],['Return-Path',one(h,'return-path')],['Subject',mail.subject||one(h,'subject')],['Date',one(h,'date')],['Message-ID',mail.messageId||one(h,'message-id')]].forEach(([k,v])=>field(areas.identity,k,v));
 h.forEach(x=>{const row=el(areas.fields,'div','','ha-field');el(row,'strong',x.originalKey||x.key);const d=el(row,'details');el(d,'summary',x.value.length>160?x.value.slice(0,160)+'…':x.value);el(d,'pre',x.value)});
 report=['Email header report','From: '+(address(mail.from)||'unknown'),'Subject: '+(mail.subject||'unknown'),'Hops: '+received.length,'Transit: '+(elapsed===null?'unknown':elapsed<0?'clock mismatch':duration(elapsed)),...core.map(x=>x.method.toUpperCase()+': '+(x.entries.map(e=>e.result).join(', ')||'not reported')),'ARC instances: '+arcInstances.size,'DKIM signatures: '+signatures.map(s=>'d='+(s.d||'?')+' s='+(s.s||'?')).join(', '),...Array.from(areas.observations.children).map(x=>x.textContent),'Results are unverified header claims.'].join('\n');
 status.textContent='Parsed '+h.length+' header fields locally. Nothing was uploaded.';
}
$('#ha-form').addEventListener('submit',e=>{e.preventDefault();void analyze()});
$('#ha-sample').addEventListener('click',()=>{input.value=SAMPLE;void analyze()});
$('#ha-clear').addEventListener('click',()=>{analysisSequence++;input.value='';results.hidden=true;report='';delete status.dataset.error;status.textContent='Cleared.';input.focus()});
$('#ha-copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(report);status.textContent='Report copied.'}catch{status.textContent='Clipboard unavailable.'}});
$('#ha-print').addEventListener('click',()=>{const details=[...results.querySelectorAll('details')],previous=details.map(d=>d.open);details.forEach(d=>d.open=true);const restore=()=>details.forEach((d,i)=>d.open=previous[i]);window.addEventListener('afterprint',restore,{once:true});window.print();});
</script>