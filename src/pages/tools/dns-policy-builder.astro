---
import Base from '../../layouts/Base.astro';
---
<Base title="Email DNS Policy Builder | howto.email" description="Discover existing email DNS, generate proposed SPF, DKIM, DMARC, MTA-STS, TLS-RPT and BIMI records, and copy change details.">
<section class="wrap page policy-builder">
<p class="kicker">TOOLS / DNS POLICY BUILDER</p>
<h1>Email DNS Policy Builder</h1>
<p class="lead">Inspect your current email DNS records, choose the protections you need, and copy proposed changes for a ticket or change request. Nothing is changed in DNS automatically.</p>
<form id="scan-form" class="panel">
<label for="domain">Domain or subdomain</label>
<div class="scan-fields"><input id="domain" name="domain" placeholder="example.com" autocomplete="off" spellcheck="false" required><button type="submit" id="scan">Discover records</button></div>
<p class="hint">Public DNS only. No login, mail credentials, or private configuration required.</p>
</form>
<p id="status" role="status" aria-live="polite">Enter a domain to begin.</p>
<div class="action-bar"><div><strong>Build your DNS configuration</strong><p class="hint">Choose controls below. Copy All produces the complete plain-text change record without displaying it on the page.</p></div><button id="copy-all" type="button">Copy All</button></div>
<p id="check-summary" class="check-summary" role="status" aria-live="polite">Select a control to generate proposed changes.</p>
<div class="builder-layout">
<section class="main-pane" aria-label="Configuration">
<div class="panel">
<div class="heading-row"><h2>Configuration</h2><div class="mode" role="group" aria-label="Builder mode"><button type="button" class="selected" data-mode="guided" aria-pressed="true">Guided</button><button type="button" data-mode="advanced" aria-pressed="false">Advanced</button></div></div>
<div class="fields">
<label for="provider">Sending provider<select id="provider"><option value="">Select a provider</option><option value="google">Google Workspace only</option><option value="m365">Microsoft 365 only</option><option value="custom">Other / multiple senders</option></select></label>
<label for="selector">DKIM selector<input id="selector" placeholder="From your sender" spellcheck="false"></label>
<label for="dkim-value">DKIM public key or CNAME target<input id="dkim-value" placeholder="From your provider" spellcheck="false"></label>
<label for="rua">DMARC report email<input id="rua" type="email" placeholder="dmarc@example.com"></label>
<label for="tls-email">TLS-RPT report email<input id="tls-email" type="email" placeholder="tls@example.com"></label>
<label class="advanced-field" for="policy" hidden>DMARC policy<select id="policy"><option value="none">none — monitor</option><option value="quarantine">quarantine</option><option value="reject">reject</option></select></label>
<input id="spf-custom" type="hidden">
<label class="advanced-field" for="mx-host" hidden>Verified inbound MX host<input id="mx-host" placeholder="mail.example.com"></label>
<label class="advanced-field" for="logo" hidden>BIMI logo HTTPS URL<input id="logo" placeholder="https://example.com/logo.svg"></label>
<label class="advanced-field" for="dmarc-sp" hidden>Subdomain policy<select id="dmarc-sp"><option value="">Inherit main policy</option><option value="none">none</option><option value="quarantine">quarantine</option><option value="reject">reject</option></select></label>
<label class="advanced-field" for="align-dkim" hidden>DKIM alignment<select id="align-dkim"><option value="r">Relaxed</option><option value="s">Strict</option></select></label>
<label class="advanced-field" for="align-spf" hidden>SPF alignment<select id="align-spf"><option value="r">Relaxed</option><option value="s">Strict</option></select></label>
<label class="advanced-field" for="pct" hidden>DMARC policy percentage<input id="pct" type="number" min="0" max="100" value="100"></label>
</div>
<p class="hint">Using multiple senders? Choose Other / multiple senders and supply a complete SPF record in Advanced mode. The defaults are starting points, not a substitute for a sender inventory.</p>
<details class="builder-guidance"><summary>How to choose a safe policy</summary>
<p><strong>SPF:</strong> Inventory every service sending mail before replacing an existing record. A record may be syntactically valid yet fail SPF because of nested DNS lookups.</p>
<p><strong>DKIM:</strong> Obtain selectors and keys from each provider. Existing DKIM records cannot be enumerated reliably without known selectors.</p>
<p><strong>DMARC:</strong> Begin with p=none and review aggregate reports. Advance to quarantine/reject after verifying legitimate sending and alignment.</p>
<p><strong>MTA-STS:</strong> Confirm inbound MX hosts and HTTPS policy availability before enforcing TLS.</p>
</details>
</div>
<div id="modules" class="modules"></div>
</section>
<textarea id="output" aria-hidden="true" tabindex="-1" hidden></textarea>
</div>
</section>
</Base>
<style>
.policy-builder{max-width:1050px;min-width:0;overflow-x:clip}.panel,.module{border:1px solid var(--border,#384456);border-radius:12px;padding:1.15rem;min-width:0;margin-bottom:1rem}.policy-builder input:not([type=checkbox]),.policy-builder select,.policy-builder button{font:inherit;max-width:100%;border:1px solid #64748b;border-radius:7px;padding:.68rem;background:#121d2d;color:inherit}.policy-builder button{cursor:pointer}.policy-builder button:focus-visible,.policy-builder input:focus-visible,.policy-builder select:focus-visible{outline:3px solid #6ba8f4;outline-offset:2px}#scan,#copy-all{background:#245fa9;color:#fff;border-color:#4786d5}.scan-fields{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.7rem;margin-top:.5rem}.builder-layout{display:block;min-width:0}.main-pane,.main-pane>.panel,.modules,.module{min-width:0;max-width:100%;overflow:hidden}.action-bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1rem 1.2rem;background:#111e2d;border:1px solid #39475c;border-radius:12px;margin:1rem 0}.action-bar .hint{margin:.35rem 0 0}.check-summary{padding:.5rem 0 1rem;line-height:1.55}.builder-guidance{margin-top:1rem;padding:.8rem;border:1px solid #33465b;border-radius:8px}.builder-guidance summary{cursor:pointer;font-weight:650}.builder-guidance p{line-height:1.55}#output[hidden]{display:none!important}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.fields label{display:grid;gap:.35rem;font-weight:600;min-width:0}.fields label[hidden]{display:none}.fields input,.fields select{width:100%;min-width:0}.hint{opacity:.8;font-size:.9rem;line-height:1.55}.heading-row,.module-top{display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap}.mode{display:flex;gap:.35rem}.mode .selected{outline:2px solid #7eb1ec}.modules{display:grid;gap:.7rem}.module h3{font-size:1.1rem;margin:0}.switch{display:flex;align-items:center;gap:.55rem;font-weight:600}.switch input{width:1.2rem;height:1.2rem}.module details{margin:.5rem 0}.module summary{cursor:pointer}.policy-builder .module pre{display:block;width:100%;min-width:0;max-width:100%;box-sizing:border-box;overflow-x:auto;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;background:#08121f;border:1px solid #304055;border-radius:7px;padding:.8rem;font-size:.84rem;line-height:1.55}.spf-editor{margin:1rem 0}.spf-editor label{display:block;font-weight:700;margin-bottom:.5rem}.policy-builder .spf-editor textarea{display:block;width:100%;box-sizing:border-box;max-width:100%;min-height:6rem;padding:.8rem;border:1px solid #64748b;border-radius:8px;background:#101b29;color:inherit;font:inherit;line-height:1.5;resize:vertical;overflow-wrap:anywhere}.policy-builder .spf-editor textarea:focus-visible{outline:3px solid #6ba8f4;outline-offset:2px}.record-label{font-size:.84rem;font-weight:700;opacity:.8}.note{font-size:.87rem}.error{color:#ffa49e}.warning{color:#f3c57b}#status{min-height:1.6em}@media(max-width:900px){.builder-layout{grid-template-columns:minmax(0,1fr)}.report-pane{position:static}}@media(max-width:600px){.fields,.scan-fields{grid-template-columns:minmax(0,1fr)}.mode{width:100%}.mode button{flex:1}}
</style>
<script>
import {validateEmailDns,senderReadinessNote} from '../../lib/email-dns-validation.js';
const $=id=>document.getElementById(id);
const names=['SPF','DKIM','DMARC','MTA-STS','TLS-RPT','BIMI'];
const descriptions={
'SPF':'Authorizes outgoing mail senders. Exactly one SPF TXT record is allowed at a hostname. DNS lookup limits and all sending sources must be checked.',
'DKIM':'Adds cryptographic signatures to mail. Your provider must supply the selector and TXT key or CNAME target.',
'DMARC':'Specifies policy for unauthenticated or unaligned mail. Begin with monitoring, then move to enforcement after verifying your senders.',
'MTA-STS':'Instructs supporting senders to use authenticated TLS to deliver inbound mail. Requires a matching HTTPS policy and validated MX hosts.',
'TLS-RPT':'Requests reports about failures to negotiate secure SMTP transport. It is optional.',
'BIMI':'Optional logo display standard that typically requires enforced DMARC and, for some mailbox providers, mark verification.'
};
const keys={'SPF':'spf','DKIM':'dkim','DMARC':'dmarc','MTA-STS':'mta_sts','TLS-RPT':'tls_rpt','BIMI':'bimi'};
let domain='',snapshot={},discovery='not scanned',scannedAt='',mode='guided';
const valid=d=>/^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i.test(d);
const txt=(x)=>typeof x==='string'?x:JSON.stringify(x);
function extract(api){
 const out={};
 const sources=api.howto_records||{},results=api.results||{};
 for(const n of names){
  const key=keys[n],alt=key.replace('_','-');
  let records=Array.isArray(sources[key])?sources[key].map(x=>txt(x.value)):[];
  const recordResult=results[key]||results[alt]||{};
  if(!records.length&&Array.isArray(recordResult.records))records=recordResult.records.map(txt);
  out[n]=records;
 }
 out.SPF=out.SPF.filter(x=>/^v=spf1(?:\s|$)/i.test(x));
 return out;
}
function before(n){if(discovery!=='complete')return 'not verified — DNS discovery unavailable';const rows=snapshot[n]||[];if(n==='DKIM'&&!rows.length)return 'not verified — DKIM selector needed';return rows.length?rows.join('\n'):'not used';}
function host(n,d){return {'SPF':d,'DKIM':$('selector').value.trim()+'._domainkey.'+d,'DMARC':'_dmarc.'+d,'MTA-STS':'_mta-sts.'+d,'TLS-RPT':'_smtp._tls.'+d,'BIMI':'default._bimi.'+d}[n]}
function propose(n,d){
 const provider=$('provider').value,selector=$('selector').value.trim(),dkim=$('dkim-value').value.trim(),rua=$('rua').value.trim(),tls=$('tls-email').value.trim(),mx=$('mx-host').value.trim(),logo=$('logo').value.trim();
 if(n==='SPF'){
  const custom=$('spf-custom').value.trim(),value=custom||(provider==='m365'?'v=spf1 include:spf.protection.outlook.com ~all':provider==='google'?'v=spf1 include:_spf.google.com ~all':'');
  return value?{host:d,type:'TXT',value,notes:['Verify all real senders and the SPF 10-lookup evaluation limit. Do not publish multiple SPF records.']}:{incomplete:'Enter or edit an SPF record in the SPF section below, or select an outbound provider.'};
 }
 if(n==='DKIM'){
  if(!selector||!dkim)return {incomplete:'Supply the provider-issued selector and public key or CNAME target.'};
  if(!/^[a-z0-9_-]{1,63}$/i.test(selector))return {incomplete:'Invalid DKIM selector.'};
  return dkim.includes('.')&&!dkim.includes('=')?{host:host(n,d),type:'CNAME',value:dkim,notes:['Verify provider CNAME destination.']}:{host:host(n,d),type:'TXT',value:'v=DKIM1; k=rsa; p='+dkim,notes:['Confirm selector, algorithm and key with your sending provider.']};
 }
 if(n==='DMARC'){
  const pct=Math.max(0,Math.min(100,Number($('pct').value)||0));const sub=$('dmarc-sp').value;
  const value='v=DMARC1; p='+$('policy').value+(sub?'; sp='+sub:'')+'; adkim='+$('align-dkim').value+'; aspf='+$('align-spf').value+'; pct='+pct+(rua?'; rua=mailto:'+rua:'');
  return {host:host(n,d),type:'TXT',value,notes:[$('policy').value==='none'?'Monitoring policy. Not DMARC enforcement.':'Do not enforce until legitimate mail alignment has been verified.']};
 }
 if(n==='MTA-STS'){
  if(!mx)return {incomplete:'Verified inbound MX hostname required to generate the HTTPS policy.'};
  return {host:host(n,d),type:'TXT',value:'v=STSv1; id='+new Date().toISOString().slice(0,10).replace(/-/g,''),extra:'HTTPS policy at https://mta-sts.'+d+'/.well-known/mta-sts.txt\nversion: STSv1\nmode: testing\nmx: '+mx+'\nmax_age: 86400',notes:['HTTPS certificate, matching MX records and policy hosting must be checked.']};
 }
 if(n==='TLS-RPT')return tls?{host:host(n,d),type:'TXT',value:'v=TLSRPTv1; rua=mailto:'+tls}:{incomplete:'Supply the TLS report mailbox.'};
 if(n==='BIMI')return logo&&/^https:\/\//i.test(logo)?{host:host(n,d),type:'TXT',value:'v=BIMI1; l='+logo,notes:['DMARC enforcement and logo/certificate prerequisites are not verified.']}:{incomplete:'Provide a valid HTTPS BIMI logo URL; DMARC enforcement is also required.'};
 return {incomplete:'Unsupported control'};
}
function enabled(n){return document.querySelector('[data-key="'+n+'"]').checked}
function build(){
 const d=$('domain').value.trim().toLowerCase();domain=d;const lines=['HOWTO.EMAIL — DNS POLICY BUILDER','Domain: '+(d||'(not entered)'),'Generated: '+new Date().toLocaleString(),'DNS discovery: '+discovery+(scannedAt?' ('+scannedAt+')':''),''];
 let fail=0,warn=0,pass=0;
 for(const n of names){
  lines.push(n);
  if(!enabled(n)){lines.push('Before: '+before(n),'After: not used','');continue;}
  if(!valid(d)){lines.push('Before: not verified','After: invalid domain','Status: FAIL','');fail++;continue}
  const p=propose(n,d);const prior=before(n);
  if(p.incomplete){lines.push('Before: '+prior,'After: not generated — '+p.incomplete,'Status: NEEDS INPUT','');warn++;continue;}
  const check=p.type==='TXT'?validateEmailDns(n,p.value):{status:'pass',issues:[]};
  const issues=[...(check.issues||[]),...(p.notes||[])];
  const existingRows=snapshot[n]||[];
  if(n==='SPF'&&existingRows.length>1)issues.push('Multiple existing SPF records detected: SPF PermError risk.');
  if(n==='DMARC'&&existingRows.length>1)issues.push('Multiple existing DMARC records detected: DMARC policy discovery may fail.');
  if(n==='SPF'&&/\b(?:include:|redirect=|\ba\b|\bmx\b|exists:)/i.test(p.value))issues.push('Recursive SPF DNS lookup count is not verified by this builder.');
  if(n==='BIMI'&&$('policy').value==='none')issues.push('BIMI generally requires an enforced DMARC policy.');
  if(prior!=='not used'&&!prior.startsWith('not verified')&&prior.trim()!==p.value.trim())issues.push('Existing value differs; replace only after reviewing production dependencies.');
  if(check.status!=='pass')fail++;else if(issues.length||discovery!=='complete')warn++;else pass++;
  lines.push('Host: '+p.host,'Type: '+p.type,'Before: '+prior,'After: '+p.value);
  if(p.extra)lines.push('Additional configuration:\n'+p.extra);
  lines.push('Status: '+(check.status==='pass'?'REVIEW':'WARNING'));
  for(const issue of issues)lines.push('Note: '+issue);
  lines.push('');
 }
 lines.push('SENDER REQUIREMENTS','Assessment: not fully verifiable from DNS alone',senderReadinessNote);
 $('output').value=lines.join('\n');
 $('check-summary').textContent=pass+' draft(s) without warnings, '+warn+' need review, '+fail+' syntax concern(s). Google/Yahoo operational compliance unverified.';
 for(const n of names){
  const el=document.querySelector('[data-card="'+n+'"]'),p=valid(d)?propose(n,d):{incomplete:'Enter a valid domain.'},on=enabled(n);
  el.querySelector('.before').textContent=before(n);
  el.querySelector('.after').textContent=on?(p.incomplete?'Needs input: '+p.incomplete:('Host: '+p.host+'\nType: '+p.type+'\nValue: '+p.value+(p.extra?'\n'+p.extra:''))):'not used';
  el.querySelector('.diagnostic').textContent=on?(p.incomplete?'Needs input':p.type==='TXT'?validateEmailDns(n,p.value).issues.join('; ')||'Draft — verify before publishing':'CNAME draft — verify with provider'):'Not enabled';
 }
}
function makeCards(){
 const wrap=$('modules');wrap.replaceChildren();
 for(const n of names){
  const a=document.createElement('article');a.className='module';a.dataset.card=n;
  const header=document.createElement('div');header.className='module-top';
  const heading=document.createElement('h3');heading.textContent=n;
  const label=document.createElement('label');label.className='switch';
  const toggle=document.createElement('input');toggle.type='checkbox';toggle.dataset.key=n;toggle.checked=false;
  label.append(toggle,document.createTextNode(' Enable'));header.append(heading,label);
  const details=document.createElement('details'),sum=document.createElement('summary');sum.textContent='ⓘ What does this do?';const para=document.createElement('p');para.textContent=descriptions[n];details.append(sum,para);
  const diag=document.createElement('p');diag.className='note diagnostic';const beforelabel=document.createElement('p');beforelabel.className='record-label';beforelabel.textContent='Current record';const pre=document.createElement('pre');pre.className='before';const afterlabel=document.createElement('p');afterlabel.className='record-label';afterlabel.textContent='Proposed record';const post=document.createElement('pre');post.className='after';
  a.append(header,details,diag,beforelabel,pre);
  if(n==='SPF'){
   const editor=document.createElement('div');editor.className='spf-editor';
   const editLabel=document.createElement('label');editLabel.htmlFor='spf-editor';editLabel.textContent='Proposed SPF record — edit here';
   const field=document.createElement('textarea');field.id='spf-editor';field.rows=3;field.placeholder='v=spf1 ip4:192.0.2.10 include:_spf.example.com ~all';field.spellcheck=false;
   field.setAttribute('aria-describedby','spf-editor-help');
   const guidance=document.createElement('p');guidance.id='spf-editor-help';guidance.className='hint';guidance.textContent='The existing record is prefilled after discovery. Edit or append authorized mechanisms; do not replace legitimate senders accidentally. Select a provider above to start from a provider template.';
   editor.append(editLabel,field,guidance);a.append(editor);
   field.addEventListener('input',()=>{$('spf-custom').value=field.value;build()});
  }
  a.append(afterlabel,post);toggle.addEventListener('change',build);wrap.append(a);
 }
}
async function loadDNS(d){
 const r=await fetch('/api/analyze?domain='+encodeURIComponent(d),{headers:{accept:'application/json'}});
 if(!r.ok)throw Error('API status '+r.status);
 const data=await r.json();
 if(!data?.results&&!data?.howto_records)throw Error('Analyzer returned no records structure');
 return extract(data);
}
$('scan-form').addEventListener('submit',async e=>{
 e.preventDefault();const d=$('domain').value.trim().toLowerCase();if(!valid(d)){$('status').textContent='Enter a valid domain.';return}
 $('scan').disabled=true;$('status').textContent='Looking up public DNS…';discovery='checking';build();
 try{snapshot=await loadDNS(d);discovery='complete';scannedAt=new Date().toLocaleString();
 const found=snapshot.SPF||[];
 if(found.length===1){$('spf-editor').value=found[0];$('spf-custom').value=found[0];}
 else {$('spf-editor').value='';$('spf-custom').value='';}
 $('status').textContent='DNS discovery complete. Review changes before publication.';}
 catch(e){snapshot={};discovery='unavailable';scannedAt='';$('status').textContent='DNS lookup unavailable. Existing records are unverified; do not publish replacements blindly.'}
 finally{$('scan').disabled=false;build()}
});
$('domain').addEventListener('input',()=>{snapshot={};discovery='not scanned';scannedAt='';$('spf-custom').value='';$('spf-editor').value='';build()});
for(const id of ['provider','selector','dkim-value','rua','tls-email','policy','mx-host','logo','dmarc-sp','align-dkim','align-spf','pct'])$(id).addEventListener('input',build);
$('provider').addEventListener('change',()=>{
 const provider=$('provider').value;
 if(provider==='google'||provider==='m365'){
  const starter=provider==='google'?'v=spf1 include:_spf.google.com ~all':'v=spf1 include:spf.protection.outlook.com ~all';
  if($('spf-editor').value.trim()&&$('spf-editor').value.trim()!==starter){
   $('status').textContent='Provider selected. Existing SPF preserved in the editor. Review and update it manually to avoid losing authorized senders.';
  }else{$('spf-editor').value=starter;$('spf-custom').value=starter;build();}
 }
});
document.querySelectorAll('[data-mode]').forEach(button=>button.addEventListener('click',()=>{mode=button.dataset.mode;document.querySelectorAll('[data-mode]').forEach(b=>{const active=b===button;b.classList.toggle('selected',active);b.setAttribute('aria-pressed',String(active))});document.querySelectorAll('.advanced-field').forEach(x=>x.hidden=mode!=='advanced');build()}));
$('copy-all').addEventListener('click',async()=>{
 const value=$('output').value;
 try{await navigator.clipboard.writeText(value);$('status').textContent='All change details copied to clipboard.';const b=$('copy-all');b.textContent='Copied';setTimeout(()=>b.textContent='Copy All',1800)}
 catch{const area=document.createElement('textarea');area.value=value;area.style.cssText='position:fixed;left:-9999px';document.body.append(area);area.select();const ok=document.execCommand('copy');area.remove();$('status').textContent=ok?'All change details copied to clipboard.':'Clipboard unavailable in this browser.';if(ok){const b=$('copy-all');b.textContent='Copied';setTimeout(()=>b.textContent='Copy All',1800)}}
});
makeCards();build();
</script>