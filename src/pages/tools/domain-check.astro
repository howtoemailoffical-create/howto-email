---
import Base from '../../layouts/Base.astro';
const recommendations={
 dmarc_missing:[['/reference/dmarc/','DMARC reference'],['/do/publish-dmarc/','Publish DMARC']],
 dmarc_monitoring:[['/do/move-dmarc-to-reject/','Move DMARC toward reject'],['/reference/dmarc-alignment/','DMARC alignment']],
 spf_missing:[['/reference/spf/','SPF reference'],['/do/audit-spf/','Audit SPF']],
 spf_problem:[['/do/investigate-spf-permerror/','Investigate SPF PermError'],['/reference/spf-lookup-limit/','SPF lookup limit'],['/do/audit-spf/','Audit SPF']],
 spf_limit:[['/reference/spf-lookup-limit/','SPF lookup limit'],['/do/audit-spf/','Audit SPF']],
 dkim_missing:[['/reference/dkim/','DKIM reference'],['/do/audit-dkim-selectors/','Audit DKIM selectors']],
 mta_sts_missing:[['/reference/mta-sts/','MTA-STS reference'],['/reference/tls-rpt-record/','TLS reporting']],
 bimi_missing:[['/reference/bimi/','BIMI reference']],
 tls_rpt_missing:[['/reference/tls-rpt-record/','TLS reporting']],
 mx:[['/reference/mx/','MX reference'],['/do/plan-mx-redundancy/','Plan MX redundancy']]
};
---
<Base title="Email Domain Check — howto.email" description="Inspect a domain's email authentication and transport-security configuration and get relevant howto.email documentation.">
<section class="wrap page domain-tool">
<p class="kicker">TOOLS / DOMAIN CHECK</p><h1>Email Domain Check</h1>
<p class="lead">Inspect public email configuration, see what deserves attention, view discovered records, and jump directly to documentation explaining it.</p>
<form id="domain-form" class="domain-form"><label for="domain">Domain name</label><div class="domain-input-row"><input id="domain" name="domain" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="example.com" required aria-describedby="domain-help"/><button type="submit">Analyze domain</button></div><p id="domain-help" class="tool-note">Public DNS and policy data only. Do not enter credentials or private information.</p></form>
<div id="tool-status" class="tool-status" role="status" aria-live="polite"></div>
<section id="results" class="tool-results" hidden aria-labelledby="results-title"><div class="results-heading"><div><p class="kicker">RESULTS</p><h2 id="results-title"></h2></div><div class="result-meta"><p id="results-counts" class="result-counts"></p><div class="result-actions"><button id="copy-records" type="button" class="report-btn">Copy all records</button><button id="copy-scan-link" type="button" class="report-btn">Copy scan link</button><button id="download-report" type="button" class="report-btn">Download report</button></div></div></div><p id="scan-time" class="scan-time"></p><div id="findings" class="findings"></div><section id="assessment" class="assessment"></section><details class="limitations"><summary>Limitations of this scan</summary><ul><li>Results are a point-in-time view of public DNS and published policy data.</li><li>DKIM selector discovery cannot prove every selector a sender may use.</li><li>DNS configuration alone cannot prove that real messages align and authenticate correctly.</li><li>Optional controls such as BIMI and MTA-STS are not required for normal email operation.</li></ul></details><details class="raw-results"><summary>Technical response</summary><div class="raw-actions"><button type="button" class="copy-btn" data-copy-target="raw-json">Copy JSON</button></div><pre><code id="raw-json"></code></pre></details><p class="tool-attribution">Results use the <a href="/integrations/api/">howto.email public DNS API</a>. This is a point-in-time DNS inspection, not a live email authentication test.</p></section>
</section>
<script define:vars={{recommendations}}>
const form=document.querySelector('#domain-form'),input=document.querySelector('#domain'),status=document.querySelector('#tool-status'),results=document.querySelector('#results'),findings=document.querySelector('#findings'),assessment=document.querySelector('#assessment'),title=document.querySelector('#results-title'),counts=document.querySelector('#results-counts'),raw=document.querySelector('#raw-json'),downloadReport=document.querySelector('#download-report'),copyRecords=document.querySelector('#copy-records'),copyScanLink=document.querySelector('#copy-scan-link'),scanTime=document.querySelector('#scan-time');
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const linksFor=k=>(recommendations[k]||[]).map(([h,l])=>`<a href="${h}">${esc(l)} →</a>`).join('');
const recordText=v=>typeof v==='string'?v:JSON.stringify(v);let scanData=null;
function collectRecords(data,name){
 const map={'DMARC':'dmarc','SPF':'spf','DKIM':'dkim','BIMI':'bimi','MTA-STS':'mta_sts','TLS-RPT':'tls_rpt','MX':'mx'};
 return (data.howto_records?.[map[name]]||[]).map(r=>({label:`${r.name}  ${r.type}`,value:r.value}));
}
function finding(level,name,summary,key='',improvement=''){return{level,name,summary,key,improvement,records:[]}}
function lookupCount(v){const m=String(v??'').match(/(\d+)\s*\/\s*10/);if(m)return Number(m[1]);const n=Number(v);return Number.isFinite(n)?n:null}
function adaptApiResponse(api,domain){
 const r=api.results||{},howto_records={};
 for(const [key,item] of Object.entries(r)){
  howto_records[key]=(item?.records||[]).map(value=>({name:item.host||domain,type:key==='mx'?'MX':'TXT',value:typeof value==='string'?value:JSON.stringify(value)}));
 }
 const dmarc=r.dmarc?.records?.[0]||'';
 const tags={};for(const chunk of dmarc.split(';')){const m=chunk.trim().match(/^([a-z]+)\s*=\s*(.*)$/i);if(m)tags[m[1].toLowerCase()]=m[2].trim()}
 const mode=r.mta_sts?.policy?.match(/^mode:\s*(enforce|testing|none)/im)?.[1]||(r.mta_sts?.found?'published (mode unknown)':'missing');
 return {domain,timestamp:new Date().toISOString(),howto_records,summary:{dmarc_policy:tags.p||'missing',spf_result:r.spf?.found?'published':'missing',dkim_selectors_found:null,mta_sts_mode:mode,bimi_enabled:r.bimi?.found===true},protocols:{dmarc:{record:dmarc,tags},spf:{record:r.spf?.records?.[0]||''},tls_rpt:{record:r.tls_rpt?.records?.[0]||''}},errors:Object.entries(r).filter(([,v])=>v?.error).map(([k,v])=>k+': '+v.error)};
}
function derive(data){
 const s=data.summary||{},out=[],dmarc=String(s.dmarc_policy||'').toLowerCase(),spf=String(s.spf_result||'').toLowerCase(),dkim=Number(s.dkim_selectors_found||0),sts=String(s.mta_sts_mode||'').toLowerCase(),lookups=lookupCount(s.spf_lookups);
 if(!dmarc||['none','missing','not_found','not found'].includes(dmarc)){const mon=dmarc==='none';out.push(finding(mon?'warning':'error','DMARC',mon?'DMARC is in monitoring mode (p=none).':'No usable DMARC policy was reported.',mon?'dmarc_monitoring':'dmarc_missing',mon?'Review aggregate reports and move toward enforcement when legitimate senders are aligned.':'Publish a DMARC record after inventorying legitimate senders.'))}else out.push(finding('pass','DMARC',`DMARC policy reported as ${dmarc}.`));
 if(!spf||['missing','none','not_found','not found','fail','permerror','temperror','invalid'].includes(spf)){const miss=!spf||['missing','none','not_found','not found'].includes(spf);out.push(finding(miss?'warning':'error','SPF',miss?'No SPF result was reported.':`SPF reported ${spf}.`,miss?'spf_missing':'spf_problem',miss?'Publish one SPF policy that accurately authorizes the domain’s real senders.':'Inspect the SPF mechanisms and DNS lookup path causing the reported failure.'))}
 else if(lookups!==null&&lookups>=10) out.push(finding('warning','SPF',`SPF currently resolves successfully but uses ${lookups}/10 DNS-querying mechanisms. It is at the RFC processing limit.`,'spf_limit','Reduce unnecessary include/redirect chains where possible. Do not flatten records blindly; keep authorization maintainable and recheck after changes.'));
 else out.push(finding('pass','SPF','SPF TXT record detected (authorization and lookup limits not independently verified).'));
 if(s.dkim_selectors_found===null)out.push(finding('optional','DKIM','Not checked: DKIM needs a known selector from an actual message.','dkim_missing','Find the selector in a DKIM-Signature header and check it explicitly.'));else if(dkim<1)out.push(finding('warning','DKIM','No DKIM selector was discovered by the scanner. This does not prove the domain never signs mail.','dkim_missing','Verify selectors from actual signed messages before changing DNS.'));else out.push(finding('pass','DKIM',`${dkim} DKIM selector${dkim===1?'':'s'} discovered.`));
 if(!sts||['none','missing','not_found','not found','off'].includes(sts))out.push(finding('optional','MTA-STS','MTA-STS was not detected. This is an optional transport-security enhancement, not evidence that email is broken.','mta_sts_missing','Consider MTA-STS with TLS-RPT if stricter inbound SMTP transport policy fits the environment.'));else out.push(finding('pass','MTA-STS',`MTA-STS mode reported as ${sts}.`));
 const tls=p=>data.protocols?.[p]||{}; const tlsRpt=tls('tls_rpt'),mx=tls('mx');
 if(tlsRpt.record)out.push(finding('pass','TLS-RPT','TLS reporting is published.'));else out.push(finding('optional','TLS-RPT','TLS-RPT was not detected. It can provide reports about SMTP TLS delivery failures.','tls_rpt_missing','Consider publishing TLS-RPT if transport-security reporting would be useful.'));
 const mxRecords=data.howto_records?.mx||[];if(mxRecords.length)out.push(finding('pass','MX',`${mxRecords.length} MX record${mxRecords.length===1?'':'s'} discovered.`,'mx'));else out.push(finding('warning','MX','No explicit MX record was returned by the scanner.','mx','Verify whether the domain is intended to receive email and review its MX configuration.'));
 if(s.bimi_enabled===false)out.push(finding('optional','BIMI','BIMI was not detected. BIMI is optional and is not required for normal authenticated email.','bimi_missing','Only pursue BIMI if brand-display requirements justify it and the domain meets its prerequisites.'));else if(s.bimi_enabled===true)out.push(finding('pass','BIMI','BIMI was detected.'));
 out.forEach(x=>x.records=collectRecords(data,x.name)); return out;
}
function spfTreeHTML(node,depth=0){if(!node)return '';const kids=node.includes||[];const rid='spf-inc-'+Math.random().toString(36).slice(2);return `<div class="spf-node" style="--depth:${Math.min(depth,6)}"><div class="spf-node-head"><strong>${esc(node.domain||'SPF include')}</strong>${node.record?`<button type="button" class="copy-btn" data-copy-target="${rid}">Copy</button>`:''}</div>${node.record?`<pre><code id="${rid}">${esc(node.record)}</code></pre>`:'<p class="record-empty">No SPF record returned for this include.</p>'}${kids.length?`<div class="spf-children">${kids.map(x=>spfTreeHTML(x,depth+1)).join('')}</div>`:''}</div>`}
function recordsHTML(item,i){if(!item.records.length)return '<p class="record-empty">No literal DNS record was returned for this check. Summary data is shown above, but it is not presented as a DNS record.</p>';const boxes=item.records.map((r,j)=>{const id=`record-${i}-${j}`;return `<div class="record-box"><div class="record-head"><span>${esc(r.label)}</span><button type="button" class="copy-btn" data-copy-target="${id}">Copy</button></div><pre><code id="${id}">${esc(recordText(r.value))}</code></pre></div>`}).join('');const tree=item.name==='SPF'?scanData?.protocols?.spf?.include_tree:null;return boxes+(tree?.includes?.length?`<details class="spf-explorer"><summary>Inspect SPF includes (${tree.includes.length} direct)</summary><p class="tool-note">Resolved during the original scan. Expanding this does not make another dmarc.mx request.</p>${tree.includes.map(x=>spfTreeHTML(x,0)).join('')}</details>`:'')}
function dmarcEvidence(){const d=scanData?.protocols?.dmarc;if(!d)return '';const tags=d.tags||d.parsed||{};const vals=['p','sp','pct','adkim','aspf','rua','ruf'].filter(k=>tags[k]!=null).map(k=>`<span><strong>${k}</strong> ${esc(Array.isArray(tags[k])?tags[k].join(', '):tags[k])}</span>`);return vals.length?`<div class="evidence"><strong>Policy details</strong><div class="evidence-grid">${vals.join('')}</div></div>`:''}
function render(items){const priority={error:0,warning:1,optional:2,pass:3};items.sort((a,b)=>priority[a.level]-priority[b.level]);findings.innerHTML=items.map((item,i)=>`<article class="finding finding-${item.level}"><div class="finding-top"><span class="finding-state">${item.level==='pass'?'PASS':item.level==='optional'?'OPTIONAL':item.level.toUpperCase()}</span><h3>${esc(item.name)}</h3></div><p>${esc(item.summary)}</p>${item.name==='DMARC'?dmarcEvidence():''}${item.improvement&&item.level!=='pass'?`<div class="improvement"><strong>Suggested improvement</strong><p>${esc(item.improvement)}</p></div>`:''}${item.key?`<div class="finding-links"><strong>Read next</strong>${linksFor(item.key)}</div>`:''}<details class="record-details"><summary>View discovered records${item.records.length?` (${item.records.length})`:''}</summary>${recordsHTML(item,i)}</details></article>`).join('');const problems=items.filter(x=>x.level==='error'||x.level==='warning').length,optional=items.filter(x=>x.level==='optional').length,passed=items.filter(x=>x.level==='pass').length;counts.textContent=`${problems} potential issue${problems===1?'':'s'} · ${optional} optional improvement${optional===1?'':'s'} · ${passed} passed`;renderAssessment(items)}
function renderAssessment(items){const issues=items.filter(x=>x.level==='error'||x.level==='warning'),opts=items.filter(x=>x.level==='optional'),passes=items.filter(x=>x.level==='pass');let s=issues.length?issues.length===1?issues[0].name+' needs attention.':issues.map(x=>x.name).join(', ')+' need attention.':'Core checks found no immediate configuration issue.';if(passes.length)s+=' '+passes.map(x=>x.name).join(', ')+' '+(passes.length===1?'is':'are')+' currently passing.';const a=[...issues,...opts];assessment.innerHTML='<p class="kicker">ASSESSMENT</p><h2>What to do next</h2><p class="assessment-summary">'+esc(s)+'</p>'+(a.length?'<div class="action-list">'+a.map(x=>'<div class="action-item"><span class="action-check" aria-hidden="true"></span><div><strong>'+(x.level==='optional'?'Optional — ':'')+esc(x.name+': '+(x.improvement||x.summary))+'</strong>'+(x.key?'<div class="action-links">'+linksFor(x.key)+'</div>':'')+'</div></div>').join('')+'</div>':'<p class="assessment-clear">No corrective action identified by these checks.</p>');}
function reportDocument(){
 const domain=title.textContent||scanData?.domain||'domain',when=scanData?.timestamp?new Date(scanData.timestamp).toLocaleString():new Date().toLocaleString();
 const body=results.cloneNode(true);body.hidden=false;body.querySelector('#download-report')?.remove();body.querySelectorAll('a').forEach(a=>{if(a.getAttribute('href')?.startsWith('/'))a.href='https://howto.email'+a.getAttribute('href')});
 const css=`body{margin:0;background:#07101a;color:#dbeafe;font:15px system-ui,sans-serif;line-height:1.55}main{max-width:980px;margin:auto;padding:36px}h1,h2,h3{color:#fff}a{color:#69b1ff}.report-head{border-bottom:1px solid #2a3b50;margin-bottom:24px}.finding,.assessment,.raw-results{border:1px solid #2a3b50;border-radius:10px;padding:18px;margin:14px 0;background:#0b1521}.finding-error,.finding-warning{border-left:4px solid #fbbf24}.finding-pass{border-left:4px solid #34d399}.finding-optional{border-left:4px solid #60a5fa}.finding-top{display:flex;gap:12px;align-items:center}.finding-state{font:700 11px ui-monospace,monospace;border:1px solid #47617d;border-radius:999px;padding:2px 7px}.record-box,.spf-node pre{border:1px solid #30445c;border-radius:7px;margin:10px 0;background:#060d15}.record-head,.spf-node-head{display:flex;justify-content:space-between;gap:10px;padding:8px 10px}.record-box pre,.spf-node pre{padding:11px;overflow:auto}.copy-btn,.report-print{background:#10243a;color:#dbeafe;border:1px solid #416181;border-radius:6px;padding:6px 10px;cursor:pointer}.action-item{display:flex;gap:10px;border-top:1px solid #26384e;padding:10px 0}.kicker{color:#60a5fa;font:700 12px ui-monospace,monospace}.tool-attribution{font-size:12px;color:#9db0c6}.report-tools{display:flex;gap:8px;margin:16px 0}.spf-node{margin-left:12px;border-left:2px solid #294463;padding-left:12px}code{white-space:pre-wrap;word-break:break-all}@media print{body{background:#fff;color:#111}main{max-width:none;padding:0}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}.finding,.assessment,.record-box,.spf-node{background:#fff;color:#111;break-inside:avoid-page}.raw-results{background:#fff;color:#111;break-before:page}.finding-error{border-left-color:#dc2626}.finding-warning{border-left-color:#d97706}.finding-pass{border-left-color:#059669}.finding-optional{border-left-color:#2563eb}h1,h2,h3{color:#111;break-after:avoid-page}.report-tools,.copy-btn{display:none}a{color:#0645ad;text-decoration:underline}.record-box pre,.spf-node pre,.raw-results pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;font-size:9pt}.raw-results summary{font-weight:700;font-size:14pt}.tool-attribution{color:#444;border-top:1px solid #ccc;padding-top:10px}@page{margin:14mm}}`;
 const script=`let printState=[];function prepareAndPrint(){printState=Array.from(document.querySelectorAll('details')).map(function(d){return d.open});document.querySelectorAll('details').forEach(function(d){d.open=true});setTimeout(function(){window.print()},100)}window.addEventListener('afterprint',function(){document.querySelectorAll('details').forEach(function(d,i){if(i<printState.length)d.open=printState[i]})});function fallbackCopy(text){var ta=document.createElement('textarea');ta.value=text;ta.setAttribute('readonly','');ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();ta.setSelectionRange(0,ta.value.length);var ok=false;try{ok=document.execCommand('copy')}catch(e){}ta.remove();return ok}function copyText(text){if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(text);return fallbackCopy(text)?Promise.resolve():Promise.reject(new Error('copy failed'))}document.getElementById('print-report').addEventListener('click',prepareAndPrint);document.addEventListener('click',function(e){var b=e.target.closest('[data-copy-target]');if(!b)return;var el=document.getElementById(b.getAttribute('data-copy-target'));if(!el)return;var old=b.textContent;copyText(el.textContent).then(function(){b.textContent='Copied';setTimeout(function(){b.textContent=old},1000)}).catch(function(){b.textContent='Select and copy';var range=document.createRange();range.selectNodeContents(el);var sel=window.getSelection();sel.removeAllRanges();sel.addRange(range)})})`;
 return '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>'+esc(domain)+' email domain report</title><style>'+css+'</style></head><body><main><header class="report-head"><p class="kicker">HOWTO.EMAIL DOMAIN CHECK REPORT</p><h1>'+esc(domain)+'</h1><p>Captured '+esc(when)+'. This is a snapshot of public lookup results at scan time.</p><div class="report-tools"><button id="print-report" class="report-print" type="button">Print / Save PDF</button></div></header>'+body.innerHTML+'<script>'+script+'<\/script></main></body></html>';
}
function downloadCurrentReport(){if(!scanData)return;const blob=new Blob([reportDocument()],{type:'text/html;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=(scanData.domain||'domain').replace(/[^a-z0-9.-]/gi,'_')+'-email-domain-report.html';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function allRecordText(){const r=scanData?.howto_records||{},labels={dmarc:'DMARC',spf:'SPF',mx:'MX / MAIL EXCHANGERS',dkim:'DKIM',mta_sts:'MTA-STS DNS',mta_sts_policy:'MTA-STS POLICY',tls_rpt:'TLS-RPT',bimi:'BIMI'};const order=['dmarc','spf','mx','dkim','mta_sts','mta_sts_policy','tls_rpt','bimi'];const sections=[];for(const key of order){const rows=r[key]||[];if(!rows.length)continue;sections.push('=== '+(labels[key]||key.toUpperCase())+' ===\n'+rows.map(x=>{const v=String(x.value),quoted=x.type==='TXT'||v.includes(' ');return 'Name:  '+x.name+'\nType:  '+x.type+'\nValue: '+(quoted?'"'+v.replace(/"/g,'\\"')+'"':v)}).join('\n\n'))}return 'HOWTO.EMAIL — DISCOVERED EMAIL RECORDS\nDomain: '+(title.textContent||'')+'\nCaptured: '+new Date().toLocaleString()+'\n\n'+sections.join('\n\n')}
async function copyValue(text,button){try{await navigator.clipboard.writeText(text);const old=button.textContent;button.textContent='Copied';setTimeout(()=>button.textContent=old,1200)}catch{button.textContent='Copy failed'}}
copyRecords.addEventListener('click',()=>copyValue(allRecordText(),copyRecords));
copyScanLink.addEventListener('click',()=>copyValue(location.origin+location.pathname+'?domain='+encodeURIComponent(title.textContent),copyScanLink));
downloadReport.addEventListener('click',downloadCurrentReport);
document.addEventListener('click',async e=>{const b=e.target.closest('[data-copy-target]');if(!b)return;const el=document.getElementById(b.dataset.copyTarget);if(!el)return;try{await navigator.clipboard.writeText(el.textContent);const old=b.textContent;b.textContent='Copied';setTimeout(()=>b.textContent=old,1200)}catch{b.textContent='Copy failed'}});
form.addEventListener('submit',async e=>{e.preventDefault();const domain=input.value.trim().toLowerCase().replace(/^https?:\/\//,'').replace(/\/.*$/,'').replace(/\.$/,'');if(!domain)return;status.textContent=`Checking ${domain}…`;results.hidden=true;try{const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),15000);let response,api;try{response=await fetch(`/api/analyze?domain=${encodeURIComponent(domain)}`,{headers:{accept:'application/json'},signal:controller.signal});const payload=await response.text();try{api=JSON.parse(payload)}catch{throw new Error('The analyzer returned an invalid response. Please try again.')}}finally{clearTimeout(timer)}if(!response.ok)throw new Error(typeof api?.error==='string'?api.error:'Lookup unavailable. Please try again.');if(!api||typeof api!=='object'||!api.results||typeof api.results!=='object')throw new Error('The analyzer returned incomplete results. Please try again.');const data=adaptApiResponse(api,domain);title.textContent=domain;scanData=data;const observed=data.timestamp?new Date(data.timestamp):new Date();scanTime.textContent='Observed '+observed.toLocaleString()+' · public DNS snapshot';render(derive(data));raw.textContent=JSON.stringify(data,null,2);results.hidden=false;status.textContent='Analysis complete.';history.replaceState(null,'',`?domain=${encodeURIComponent(domain)}`)}catch(err){status.textContent=err?.name==='AbortError'?'The lookup timed out after 15 seconds. Please retry.':err instanceof TypeError?'The lookup service could not be reached. Please retry.':err instanceof Error?err.message:'Lookup failed.'}});
const initial=new URLSearchParams(location.search).get('domain');if(initial){input.value=initial;form.requestSubmit()}
</script></Base>
