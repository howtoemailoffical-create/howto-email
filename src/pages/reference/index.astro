---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const articles=(await getCollection('articles')).filter(a=>a.data.section==='Reference').sort((a,b)=>a.data.title.localeCompare(b.data.title));
---
<Base title="Email reference | howto.email" description="Technical references for email protocols, DNS records, authentication standards and operational terminology."><div class="wrap page"><p class="kicker">REFERENCE</p><h1>Look up the exact thing.</h1><p class="lead">Protocol behavior, record syntax, ports, status codes and the details you need when you're already in the middle of the work.</p><div class="article-list">{articles.map(a=><a class="article-row" href={'/'+a.id+'/'}><div><h2>{a.data.title}</h2><p>{a.data.description}</p></div><span>→</span></a>)}</div></div></Base>