---
import Base from '../../layouts/Base.astro';
---
<Base title="Email knowledge assessment — howto.email" description="Take a 40-question email knowledge assessment without an account.">
<section class="wrap page"><p class="kicker">KNOWLEDGE ASSESSMENT</p><h1>Email Knowledge Assessment</h1>
<p class="lead">40 randomized questions · 60 minutes · 80% to pass · unlimited retakes. No account required. Your name is used only locally for your certificate.</p>
<div class="card" style="max-width:850px;padding:24px">
<div id="intro"><p>This assessment is not an accredited professional certification. Passing earns a HowToEmail certificate of completion.</p><button class="primary-action" id="start">Begin assessment</button></div>
<div id="exam" hidden><p id="status" role="status"></p><h2 id="question"></h2><form id="answer"><fieldset><legend class="sr-only">Select one answer</legend><div id="options"></div></fieldset><button class="primary-action" type="submit">Save and continue</button></form><button id="back" type="button">Previous question</button><button id="finish" type="button">Submit assessment</button></div>
<div id="result" hidden role="status"><h2>Assessment results</h2><p id="score"></p><div id="credential" hidden><p>Congratulations. Enter a display name for your local certificate. This name is never sent to HowToEmail.</p><label for="display-name">Certificate name</label> <input id="display-name" maxlength="100" autocomplete="off" placeholder="Your name"><p><button id="download" type="button">Print or save certificate</button> <button id="badge" type="button">Download badge</button></p><p><a id="verify" rel="noopener" target="_blank">Verify credential</a></p><p id="linkedin"></p></div><p><button id="retry" type="button">Try again</button></p></div>
<p id="error" role="alert" hidden></p></div></section>
<style>
fieldset{border:0;padding:0;margin:0}#options label{display:block;border:1px solid #456;border-radius:8px;padding:.8rem;margin:.5rem 0;cursor:pointer}#options input{margin-right:.7rem}button{padding:.7rem 1rem;cursor:pointer;margin:.25rem}input[type=text],#display-name{padding:.65rem;border:1px solid #789;background:#102033;color:white}button:focus-visible,input:focus-visible{outline:3px solid #9df;outline-offset:3px}
</style>
<script>
const $=id=>document.getElementById(id);let session=null,questions=[],answers={},index=0,deadline=0,credentialToken=null;
function show(id){for(const x of ['intro','exam','result'])$(x).hidden=x!==id}
function error(msg){$('error').textContent=msg;$('error').hidden=false}
async function request(path,body){const r=await fetch('/api/assessment/'+path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d}
function render(){const q=questions[index];$('status').textContent=`Question ${index+1} of ${questions.length} · ${Object.keys(answers).length} answered · ${Math.max(0,Math.ceil((deadline-Date.now())/60000))} minutes remaining`;$('question').textContent=q.question;$('options').replaceChildren();q.choices.forEach((choice,i)=>{const label=document.createElement('label'),input=document.createElement('input');input.type='radio';input.name='answer';input.value=String(i);input.checked=answers[q.id]===i;label.append(input,document.createTextNode(choice));$('options').append(label)});$('back').disabled=index===0;$('answer').querySelector('button').textContent=index===questions.length-1?'Save answer':'Save and continue'}
$('start').onclick=async()=>{try{$('start').disabled=true;$('error').hidden=true;const d=await request('start',{});session=d.token;questions=d.questions;deadline=d.expires;answers={};index=0;show('exam');render()}catch(e){error(e.message)}finally{$('start').disabled=false}};
$('answer').onsubmit=e=>{e.preventDefault();const chosen=$('answer').querySelector('input:checked');if(!chosen){error('Choose an answer before continuing.');return}answers[questions[index].id]=Number(chosen.value);$('error').hidden=true;if(index<questions.length-1)index++;render()};
$('back').onclick=()=>{if(index>0){index--;render()}};
$('finish').onclick=async()=>{if(!confirm(`Submit now? ${Object.keys(answers).length} of 40 questions answered.`))return;try{$('finish').disabled=true;const d=await request('submit',{token:session,answers});$('score').textContent=`${d.score} of ${d.total} correct (${d.percentage}%). ${d.passed?'Passed':'Not passed'}.`;credentialToken=d.credentialToken||null;$('credential').hidden=!d.passed;if(d.passed){$('verify').href='/verify/?token='+encodeURIComponent(credentialToken);$('linkedin').textContent='LinkedIn: add a License & Certification named HowToEmail Email Knowledge Assessment, issued by HowToEmail, using the credential ID '+d.credentialId+' and the verification URL above.'}show('result')}catch(e){error(e.message)}finally{$('finish').disabled=false}};
$('retry').onclick=()=>{show('intro');$('error').hidden=true};
$('download').onclick=()=>{const name=$('display-name').value.trim()||'Certificate Holder';const w=window.open('','_blank');if(!w){error('Allow pop-ups to print your certificate.');return}const doc=w.document;doc.title='HowToEmail Certificate of Completion';const h=doc.createElement('h1');h.textContent='HowToEmail — Certificate of Completion';const p=doc.createElement('p');p.textContent=`Awarded to ${name} for passing the Email Knowledge Assessment. Verification: ${$('verify').href}`;doc.body.append(h,p);w.print()};
$('badge').onclick=()=>{const canvas=document.createElement('canvas');canvas.width=800;canvas.height=400;const ctx=canvas.getContext('2d');ctx.fillStyle='#102033';ctx.fillRect(0,0,800,400);ctx.fillStyle='#fff';ctx.textAlign='center';ctx.font='bold 42px sans-serif';ctx.fillText('howto.email',400,120);ctx.font='bold 32px sans-serif';ctx.fillText('Email Knowledge Assessment',400,205);ctx.font='26px sans-serif';ctx.fillText('PASSED · 80% minimum',400,270);const a=document.createElement('a');a.href=canvas.toDataURL('image/png');a.download='howto-email-badge.png';a.click()};
</script>
</Base>