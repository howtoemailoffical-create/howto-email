---
import Base from '../../layouts/Base.astro';
---
<Base title="Practice email knowledge — howto.email" description="Free, private email knowledge quizzes covering SMTP, SPF, DKIM, DMARC, security, and deliverability.">
  <section class="wrap page quiz-page">
    <p class="kicker">LEARN · PRACTICE · IMPROVE</p>
    <h1>Test your email knowledge</h1>
    <p class="lead">Study with a randomized practice quiz drawn from 200 email questions, with explanations and links to relevant documentation. No accounts or stored answers.</p>
    <p><a class="primary-action" href="/quiz/assessment/">Take the 40-question assessment →</a></p>

    <div class="card quiz-card" id="quiz-app">
      <div id="setup">
        <h2>Set up your practice quiz</h2>
        <p>Choose a topic or mix all five. You can end a session at any point and view your score.</p>
        <div class="quiz-controls">
          <div><label for="category">Topic</label><select id="category">
            <option value="all">All five topics</option>
            <option>Fundamentals</option><option>Authentication</option><option>Security</option>
            <option>Deliverability</option><option>Troubleshooting</option>
          </select></div>
          <div><label for="count">Number of questions</label><select id="count">
            <option value="10">10 questions</option><option value="25">25 questions</option>
            <option value="50">50 questions (or all available)</option>
            <option value="all">All available</option>
          </select></div>
        </div>
        <button class="primary-action" id="start" type="button">Start practicing →</button>
      </div>

      <div id="quiz" hidden>
        <div class="quiz-top"><p id="progress" aria-live="polite"></p><p id="running-score" aria-live="polite"></p></div>
        <progress id="progress-meter" max="100" value="0" aria-label="Quiz progress"></progress>
        <p class="kicker" id="topic"></p>
        <h2 id="question" tabindex="-1"></h2>
        <form id="answer-form">
          <fieldset><legend class="sr-only">Select your answer</legend><div id="choices"></div></fieldset>
          <button class="primary-action" id="check" type="submit">Check answer</button>
        </form>
        <div id="feedback" class="quiz-feedback" hidden role="status" aria-live="polite">
          <p id="feedback-result"></p><p id="feedback-explanation"></p>
          <p><a id="read-more" href="/learn/">Learn more about this topic →</a></p>
        </div>
        <div class="quiz-actions">
          <button id="next" type="button" hidden>Next question →</button>
          <button id="exit" type="button">Finish and view score</button>
        </div>
      </div>

      <div id="results" hidden role="status" aria-live="polite">
        <p class="kicker">PRACTICE COMPLETE</p>
        <h2>Your practice results</h2>
        <p class="score" id="score"></p>
        <p id="score-note"></p>
        <p>No session history or identifying information is saved.</p>
        <button class="primary-action" id="again" type="button">Practice again →</button>
        <a class="secondary-action" href="/quiz/assessment/">Try the certificate assessment →</a>
      </div>
      <p id="error" class="quiz-error" role="alert" hidden></p>
    </div>
  </section>
</Base>
<style>
.quiz-card{max-width:850px;padding:clamp(20px,4vw,36px)}
.quiz-controls{display:flex;flex-wrap:wrap;gap:20px;margin:24px 0}
.quiz-controls>div{min-width:min(100%,270px);flex:1}
.quiz-controls label{display:block;margin-bottom:8px;font-weight:650}
.quiz-controls select{display:block;width:100%;min-height:44px;padding:10px;border:1px solid #5b7495;border-radius:8px;background:#102033;color:#fff}
.quiz-top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.quiz-top p{margin:0 0 10px}
progress{display:block;width:100%;height:8px;margin:0 0 24px}
fieldset{padding:0;margin:0;border:0}
#choices label{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;margin:10px 0;border:1px solid #486380;border-radius:10px;cursor:pointer}
#choices label:has(input:checked){border-color:#86caff;background:#17334c}
#choices input{margin-top:4px;flex:none}
.quiz-feedback{border-left:4px solid #74c7f5;padding:12px 20px;margin:22px 0;background:#12283c;border-radius:0 8px 8px 0}
.quiz-feedback p{margin:8px 0}
.quiz-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:20px}
.quiz-card button{min-height:44px;padding:10px 18px;cursor:pointer}
.quiz-card button:disabled{cursor:wait;opacity:.65}
.quiz-card :is(button,select,input,a):focus-visible{outline:3px solid #89dbff;outline-offset:3px}
.quiz-error{border-left:4px solid #fba;padding:12px;color:#ffe4dd;background:#4b2129}
.score{font-size:clamp(2rem,6vw,3.5rem);font-weight:800;margin:16px 0}
[hidden]{display:none!important}
</style>
<script>
const $ = id => document.getElementById(id);
let token = null, questions = [], index = 0, checked = false, answered = 0, correct = 0;
function show(panel) {
  for (const id of ['setup','quiz','results']) $(id).hidden = id !== panel;
}
function fail(message) { $('error').textContent = message; $('error').hidden = false; }
function clearError() { $('error').hidden = true; $('error').textContent = ''; }
async function post(action, data) {
  const response = await fetch('/api/assessment/' + action, {
    method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(data), cache:'no-store'
  });
  const result = await response.json();
  if (!response.ok) throw new Error(result.error || 'Service unavailable');
  return result;
}
function render() {
  const q = questions[index];
  checked = false;
  $('topic').textContent = q.category;
  $('progress').textContent = 'Question ' + (index + 1) + ' of ' + questions.length;
  $('running-score').textContent = correct + ' correct · ' + answered + ' answered';
  $('progress-meter').value = Math.round((index / questions.length) * 100);
  $('question').textContent = q.question;
  $('choices').replaceChildren();
  q.choices.forEach((choice, i) => {
    const label = document.createElement('label'), input = document.createElement('input'), span = document.createElement('span');
    input.type = 'radio'; input.name = 'answer'; input.value = String(i); input.required = true;
    span.textContent = choice; label.append(input, span); $('choices').append(label);
  });
  $('answer-form').hidden = false; $('feedback').hidden = true; $('next').hidden = true;
  $('question').focus();
}
async function start() {
  $('start').disabled = true; clearError();
  try {
    const data = await post('practice/start', {category:$('category').value, count:$('count').value});
    token = data.token; questions = data.questions; index = 0; answered = 0; correct = 0;
    if (!questions.length) throw new Error('There are no questions available for that topic.');
    show('quiz'); render();
  } catch (e) { fail(e.message); }
  finally { $('start').disabled = false; }
}
async function checkAnswer(event) {
  event.preventDefault();
  if (checked) return;
  const selection = $('answer-form').querySelector('input:checked');
  if (!selection) { fail('Select an answer to continue.'); return; }
  const q = questions[index];
  $('check').disabled = true; clearError();
  try {
    const selected = Number(selection.value);
    const result = await post('practice/check', {token, id:q.id, answer:selected});
    checked = true; answered++; correct += Number(result.correct);
    $('feedback-result').textContent = result.correct ? 'Correct!' : 'Not quite. Correct answer: ' + q.choices[result.correctIndex];
    $('feedback-explanation').textContent = result.explanation;
    $('read-more').href = result.url;
    $('feedback').hidden = false; $('answer-form').hidden = true; $('next').hidden = false;
    $('running-score').textContent = correct + ' correct · ' + answered + ' answered';
    $('next').textContent = index === questions.length - 1 ? 'View results →' : 'Next question →';
    $('next').focus();
  } catch (e) { fail(e.message); }
  finally { $('check').disabled = false; }
}
function finish() {
  const percentage = answered ? Math.round(100 * correct / answered) : 0;
  $('score').textContent = correct + '/' + answered + ' (' + percentage + '%)';
  $('score-note').textContent = 'You answered ' + answered + ' of ' + questions.length + ' questions.';
  $('progress-meter').value = 100;
  show('results');
  token = null; questions = [];
}
$('start').addEventListener('click', start);
$('again').addEventListener('click', () => {clearError();show('setup');});
$('answer-form').addEventListener('submit', checkAnswer);
$('next').addEventListener('click', () => {if (++index >= questions.length) finish(); else render();});
$('exit').addEventListener('click', finish);
</script>