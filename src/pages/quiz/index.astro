---
import Base from '../../layouts/Base.astro';
---
<Base title="Email knowledge quiz — howto.email" description="Practice against a 200-question email engineering question bank. No account, tracking or answer history.">
<section class="wrap page">
  <p class="kicker">LEARN · PRACTICE</p>
  <h1>Test your email knowledge</h1>
  <p class="lead">Practice with explanations after each answer, or take the 40-question assessment to earn a verifiable certificate. No account or saved results.</p>
  <p><a class="primary-action" href="/quiz/assessment/">Take the certificate assessment →</a></p>
  <div class="card quiz-card">
    <div id="setup">
      <h2>Set up practice</h2>
      <div class="form-grid">
        <label>Topic <select id="category"><option value="all">All topics</option><option>Fundamentals</option><option>Authentication</option><option>Security</option><option>Deliverability</option><option>Troubleshooting</option></select></label>
        <label>Questions <select id="count"><option value="10">10</option><option value="25">25</option><option value="50">50 (if available)</option><option value="all">All in topic</option></select></label>
      </div>
      <p class="muted">Questions and answer positions are randomized. Choose an answer to see why it is right or wrong, with a related reference article.</p>
      <button id="start" type="button" class="primary-action">Start practice →</button>
    </div>
    <div id="quiz" hidden>
      <p id="progress" aria-live="polite"></p>
      <div class="progress-track" aria-hidden="true"><div id="progress-bar"></div></div>
      <h2 id="question" tabindex="-1"></h2>
      <form id="answers">
        <fieldset><legend class="sr-only">Select one answer</legend><div id="choices"></div></fieldset>
        <button type="submit" class="primary-action">Check answer</button>
      </form>
      <div id="feedback" class="feedback" role="status" aria-live="polite" hidden></div>
      <div class="actions"><button id="next" type="button" hidden>Next question →</button><button id="exit" type="button">Finish and view score</button></div>
    </div>
    <div id="results" hidden>
      <h2>Practice results</h2><p id="score" role="status" aria-live="polite"></p>
      <p class="muted">Results are shown here only; nothing is saved on the server.</p>
      <button id="again" type="button" class="primary-action">Practice again</button>
      <a href="/quiz/assessment/">Try the assessment →</a>
    </div>
    <p id="error" class="error" role="alert" hidden></p>
  </div>
</section>
<style>
.quiz-card{max-width:860px;padding:clamp(16px,3vw,30px)}.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}.form-grid label{display:grid;gap:7px;font-weight:650}.form-grid select{width:100%;padding:12px;background:#102033;color:#fff;border:1px solid #647b97;border-radius:8px}.muted{opacity:.85}fieldset{border:0;padding:0;margin:0}#choices{display:grid;gap:10px;margin:20px 0}#choices label{display:flex;gap:12px;align-items:flex-start;padding:13px;border:1px solid #526b85;border-radius:9px;cursor:pointer;min-height:48px;overflow-wrap:anywhere}#choices label:has(input:checked){border-color:#8bd0ff;background:#15334d}#choices input{margin-top:4px;flex-shrink:0}.progress-track{height:8px;border-radius:8px;background:#293c50;overflow:hidden}.progress-track div{height:100%;width:0;background:#75c8f3;transition:width .2s}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.feedback{border-left:4px solid #8ac8e8;padding:15px;margin:12px 0;background:#102738;overflow-wrap:anywhere}.feedback p{margin:0 0 8px}.error{border-left:4px solid #f88;background:#381c27;padding:12px}.quiz-card button{cursor:pointer;padding:12px 16px;min-height:44px}.quiz-card button:disabled{opacity:.6;cursor:wait}.quiz-card :is(button,select,input,a):focus-visible{outline:3px solid #9be8ff;outline-offset:3px}[hidden]{display:none!important}
</style>
<script>
const $ = id => document.getElementById(id);
const views = ['setup','quiz','results'];
let questions=[],session='',index=0,correct=0,answered=0,locked=false;
function show(view){for(const v of views) $(v).hidden=v!==view}
function error(message){$('error').textContent=message;$('error').hidden=false}
function clearError(){$('error').hidden=true;$('error').textContent=''}
async function api(endpoint,body){
  const r=await fetch('/api/assessment/'+endpoint,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body),cache:'no-store'});
  const data=await r.json().catch(()=>({error:'The assessment service returned an invalid response.'}));
  if(!r.ok)throw Error(data.error||'The assessment service is unavailable.');
  return data;
}
function render(){
  const q=questions[index];locked=false;
  $('progress').textContent='Question '+(index+1)+' of '+questions.length+' · '+q.category+' · '+correct+' correct';
  $('progress-bar').style.width=(index/questions.length*100)+'%';
  $('question').textContent=q.question;
  const choices=$('choices');choices.replaceChildren();
  q.choices.forEach((choice,i)=>{
    const label=document.createElement('label'),input=document.createElement('input');
    input.type='radio';input.name='answer';input.value=String(i);input.required=true;
    label.append(input,document.createTextNode(choice));choices.append(label);
  });
  $('answers').hidden=false;$('feedback').hidden=true;$('next').hidden=true;
  $('question').focus();
}
async function start(){
  clearError();$('start').disabled=true;$('again').disabled=true;
  try{
    const d=await api('practice/start',{category:$('category').value,count:$('count').value});
    questions=d.questions;session=d.token;index=correct=answered=0;show('quiz');render();
  }catch(e){error(e.message)}
  finally{$('start').disabled=false;$('again').disabled=false}
}
function finish(){
  $('score').textContent=correct+' correct of '+answered+' answered ('+
    (answered?Math.round(correct/answered*100):0)+'%). '+(questions.length-answered)+' not answered.';
  show('results');$('progress-bar').style.width='100%';
}
$('start').addEventListener('click',start);
$('again').addEventListener('click',()=>{show('setup');clearError();$('start').focus()});
$('answers').addEventListener('submit',async event=>{
  event.preventDefault();
  if(locked)return;
  const selected=$('answers').querySelector('input:checked');
  if(!selected){error('Choose an answer first.');return}
  locked=true;clearError();
  try{
    const q=questions[index];
    const data=await api('practice/check',{token:session,id:q.id,answer:Number(selected.value)});
    answered++;if(data.correct)correct++;
    const box=$('feedback');box.replaceChildren();
    const para=document.createElement('p');para.textContent=(data.correct?'Correct. ':'Not quite. ')+data.explanation;
    const answer=document.createElement('p');answer.textContent='Correct answer: '+q.choices[data.correctIndex];
    const link=document.createElement('a');link.href=data.url;link.textContent='Read the related reference →';
    box.append(para,answer,link);box.hidden=false;$('answers').hidden=true;
    $('next').hidden=false;$('next').textContent=index===questions.length-1?'View results →':'Next question →';$('next').focus();
  }catch(e){locked=false;error(e.message)}
});
$('next').addEventListener('click',()=>{if(++index>=questions.length)finish();else render()});
$('exit').addEventListener('click',finish);
</script>
</Base>