---
import { getCollection, render } from 'astro:content';
import Article from '../layouts/Article.astro';

// Build stable public URLs from the article section and filename.
// The content loader's ID can include directory segments; normalize it
// so every article has one predictable /learn/, /reference/, or /do/ route.
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const seen = new Set();
  return articles.map(article => {
    const filename = article.id.split('/').pop()?.replace(/\.(md|mdx)$/i, '') || '';
    const section = article.data.section.toLowerCase();
    const slug = section + '/' + filename;
    if (!filename || seen.has(slug)) throw new Error('Duplicate or invalid article route: ' + slug);
    seen.add(slug);
    return { params: { slug }, props: { article } };
  });
}
const { article } = Astro.props;
const { Content } = await render(article);
---
<Article title={article.data.title} description={article.data.description} section={article.data.section} tags={article.data.tags}><Content /></Article>
