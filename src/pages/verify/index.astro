---
import Base from '../../layouts/Base.astro';
---
<Base title="Verify a HowToEmail credential — howto.email" description="Independently verify an email knowledge assessment result using its signed credential token. No login required.">
<section class="wrap page">
  <p class="kicker">HOWTO.EMAIL · ASSESSMENT</p><h1>Assessment verification</h1>
  <p class="lead">Check a completion credential and copy its verification link for LinkedIn or sharing.</p>
  <div class="card verify-card">
    <details id="verification-form" open><summary>Verify a credential</summary>
    <form id="form">
      <label for="token">Verification URL or signed credential token</label>
      <textarea id="token" rows="3" spellcheck="false" autocomplete="off" required placeholder="Paste a verification URL or the token from your certificate"></textarea>
      <button class="primary-action" type="submit">Verify credential</button>
    </form>
    </details>
    <div id="result" aria-live="polite" role="status"></div>
  </div>
  <p><a href="/quiz/assessment/">Take the assessment →</a></p>
  <details class="privacy-note"><summary>About verification and privacy</summary><p>Credential links contain an encoded, signed result; anyone you share a link with can view the issuing date, credential ID, and score. New links use a compact signed token in the URL query for sharing on LinkedIn. The token contains no name. The URL may appear in browser history and infrastructure logs. Older fragment links remain supported.</p></details>
</section>
<style>
.verify-card{margin-top:28px}#verification-form summary,.privacy-note summary{cursor:pointer;font-weight:650;padding:12px 0}#verification-form[open]{margin-bottom:24px}#result:empty{display:none}.privacy-note{max-width:850px;margin-top:24px;color:#b9cadb}.privacy-note p{font-size:.9rem;line-height:1.7}
.verify-card{max-width:850px;padding:clamp(16px,3vw,30px)}#form label{display:block;font-weight:650;margin-bottom:10px}#token{box-sizing:border-box;width:100%;padding:12px;background:#102033;border:1px solid #6e8ba8;color:#fff;border-radius:7px;overflow-wrap:anywhere}#form button{padding:12px 16px;min-height:44px;margin:14px 0;cursor:pointer}#form :is(button,textarea):focus-visible{outline:3px solid #9be8ff;outline-offset:3px}#result{overflow-wrap:anywhere}#result h2{margin-bottom:8px}.verified{padding:clamp(18px,3vw,32px);border:1px solid #426b60;border-radius:12px;background:linear-gradient(135deg,#102c2b,#0c1b29)}.not-verified{border-left:4px solid #f8b36c;padding:12px;background:#342c22}
</style>
<style is:global>
#result .verified-status{color:#9ce6bf;font-size:.85rem;font-weight:750;letter-spacing:.06em;text-transform:uppercase;margin:0 0 10px}#result h2{font-size:clamp(1.5rem,3vw,2rem);line-height:1.2;margin:0 0 24px}#result .credential-facts{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:0 0 28px}#result .fact:last-child{grid-column:1/-1}#result dt{font-size:.85rem;color:#a8c1d3;margin-bottom:5px}#result dd{margin:0;font-size:1.1rem;font-weight:650;overflow-wrap:anywhere}#result .fact:last-child dd{font-family:monospace;font-size:.95rem}#result .share-link{border-top:1px solid #38534f;padding-top:22px}#result .share-link label{display:block;font-weight:650;margin-bottom:10px}#result .verification-link{box-sizing:border-box;width:100%;padding:12px;border:1px solid #587b8c;border-radius:7px;background:#091722;color:#dcefff;font-size:.9rem}#result .copy-link{margin-top:12px;padding:12px 18px;min-height:44px;cursor:pointer}#result .copy-feedback{font-size:.9rem;color:#a7e6c5;margin:10px 0;min-height:1.5em}#result .credential-note{font-size:.85rem;line-height:1.6;color:#adc0cf;margin:20px 0 0}#result :is(input,button):focus-visible{outline:3px solid #9be8ff;outline-offset:3px}@media(max-width:520px){#result .credential-facts{grid-template-columns:1fr}#result .copy-link{width:100%}}
</style>
<script>
const input=document.getElementById('token'),result=document.getElementById('result');
function tokenFrom(value){
  const text=value.trim();
  if(!text)return '';
  try{
    const url=new URL(text);
    if(url.origin!==location.origin || url.pathname.replace(/\/$/,'')!=='/verify')return '';
    const fragment=new URLSearchParams(url.hash.replace(/^#/,''));
    return url.searchParams.get('token')||fragment.get('token')||'';
  }catch{return text}
}
async function verify(){
  const token=tokenFrom(input.value);
  if(!token){result.textContent='Enter a valid token or a verification link from howto.email.';result.className='not-verified';return}
  result.textContent='Checking signature…';result.className='';
  try{
    const response=await fetch('/api/assessment/verify',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({token}),cache:'no-store'});
    const data=await response.json();
    if(!response.ok)throw Error(data.error||'Verification unavailable');
    if(!data.valid){result.textContent='Credential not valid. Check that the entire token was copied correctly.';result.className='not-verified';return}
    const c=data.credential;
    const make=(tag,className,text)=>{const el=document.createElement(tag);el.className=className;if(text!==undefined)el.textContent=text;return el};
    const status=make('p','verified-status','✓ Verified completion');
    const title=make('h2','','Email Knowledge Assessment');
    const facts=make('dl','credential-facts');
    for(const [label,value] of [['Score',c.score+' / '+c.total+' ('+Math.round(c.score/c.total*100)+'%)'],['Result','Passed'],['Issued',new Date(c.issued).toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'})],['Credential ID',c.id]]){
      const row=make('div','fact');row.append(make('dt','',label),make('dd','',value));facts.append(row);
    }
    const note=make('p','credential-note','This verifies the assessment result and issue date. It does not verify the holder’s identity or represent professional accreditation.');
    result.replaceChildren(status,title,facts);result.className='verified';
    document.getElementById('verification-form').open=false;
    if(data.credentialToken){
      const shortURL=new URL('/verify/',location.origin);shortURL.searchParams.set('token',data.credentialToken);
      const share=make('div','share-link'),label=make('label','','Verification link'),link=make('input','verification-link');
      link.id='share-url';label.htmlFor=link.id;link.type='text';link.readOnly=true;link.value=shortURL.href;
      link.addEventListener('click',()=>link.select());
      const copy=make('button','primary-action copy-link','Copy verification link');copy.type='button';
      const feedback=make('p','copy-feedback','');feedback.setAttribute('role','status');
      copy.addEventListener('click',async()=>{
        try{await navigator.clipboard.writeText(link.value);copy.textContent='Copied!';feedback.textContent='Ready to paste into LinkedIn’s Credential URL field.';}
        catch{link.focus();link.select();feedback.textContent='Link selected. Press Ctrl+C (or Command+C) to copy.';}
      });
      share.append(label,link,copy,feedback);result.append(share);
    }
    result.append(note);
  }catch(e){result.textContent='Unable to verify: '+e.message;result.className='not-verified'}
}
document.getElementById('form').addEventListener('submit',e=>{e.preventDefault();verify()});
if(location.hash||location.search){
  input.value=new URLSearchParams(location.search).get('token')||new URLSearchParams(location.hash.slice(1)).get('token')||'';
  if(input.value)verify();

}
</script>
</Base>